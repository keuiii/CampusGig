{
  "name": "campusgig",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --noUnusedLocals",
    "check": "npm run typecheck && npm --prefix mobile run typecheck && npm --prefix api run build",
    "format": "prettier --write app mobile/App.tsx mobile/src api/src README.md ROADMAP.md ARCHITECTURE.md",
    "format:check": "prettier --check app mobile/App.tsx mobile/src api/src README.md ROADMAP.md ARCHITECTURE.md",
    "api:dev": "npm --prefix api run dev",
    "api:build": "npm --prefix api run build",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:web": "npm --prefix mobile run web",
    "db:generate": "npm --prefix api run prisma:generate",
    "db:migrate": "npm --prefix api run prisma:migrate",
    "db:studio": "npm --prefix api run prisma:studio",
    "db:seed": "npm --prefix api run prisma:seed"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prettier": "3.6.2",
    "typescript": "^5.9.2"
  }
}
