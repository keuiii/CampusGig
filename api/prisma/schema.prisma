generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRole {
  CLIENT
  STUDENT
  PROVIDER
  ORG_MEMBER
  SCHOOL_ADMIN
  ADMIN
}

enum AccountCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SchoolStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum VerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  REJECTED
  ARCHIVED
}

enum DeliveryMethod {
  ONLINE
  IN_PERSON
  HYBRID
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum ServiceMediaKind {
  COVER
  PORTFOLIO
}

enum OrderStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum OrderFilePurpose {
  REQUIREMENT
  MESSAGE_ATTACHMENT
  DELIVERABLE
  REVISION
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum RevisionStatus {
  OPEN
  RESOLVED
  CANCELLED
}

model User {
  id                String                    @id @default(uuid()) @db.Uuid
  email             String                    @unique
  passwordHash      String
  displayName       String
  avatarPath        String?
  status            UserStatus                @default(PENDING)
  lastSeenAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  emailVerifiedAt   DateTime?
  roles             UserRoleAssignment[]
  studentProfile    StudentProfile?
  providerProfile   ProviderProfile?
  services          Service[]                 @relation("ProviderServices")
  clientOrders      Order[]                   @relation("ClientOrders")
  providerOrders    Order[]                   @relation("ProviderOrders")
  sentMessages      Message[]
  conversationLinks ConversationParticipant[]
  uploadedFiles     OrderFile[]
  reviewsWritten    Review[]                  @relation("ReviewsWritten")
  reviewsReceived   Review[]                  @relation("ReviewsReceived")
  statusChanges     OrderStatusHistory[]
  revisionRequests  RevisionRequest[]
  accountCodes      AccountCode[]
  schoolAdminAssignment SchoolAdminAssignment?
  notifications      Notification[]            @relation("NotificationRecipient")
}

model AccountCode {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  purpose   AccountCodePurpose
  codeHash  String
  expiresAt DateTime
  attempts  Int                @default(0)
  consumedAt DateTime?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model ProviderProfile {
  userId       String   @id @db.Uuid
  headline     String
  bio          String
  skills       String[]
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRoleAssignment {
  userId    String   @db.Uuid
  role      UserRole
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model School {
  id              String                @id @default(uuid()) @db.Uuid
  name            String
  shortName       String
  emailDomain     String?
  address         String?
  city            String                @default("Lipa City")
  status          SchoolStatus          @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  studentProfiles StudentProfile[]
  verifications   VerificationRequest[]
  administrators  SchoolAdminAssignment[]
}

model SchoolAdminAssignment {
  userId    String   @id @db.Uuid
  schoolId  String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model StudentProfile {
  userId              String             @id @db.Uuid
  schoolId            String             @db.Uuid
  studentNumberCipher String?
  program             String?
  yearLevel           Int?
  bio                 String?
  verificationStatus  VerificationStatus @default(UNSUBMITTED)
  verifiedAt          DateTime?
  ratingAverage       Decimal            @default(0) @db.Decimal(3, 2)
  reviewCount         Int                @default(0)
  completedOrderCount Int                @default(0)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  school              School             @relation(fields: [schoolId], references: [id])

  @@index([schoolId, verificationStatus])
}

model VerificationRequest {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  schoolId          String             @db.Uuid
  studentIdFilePath String
  status            VerificationStatus @default(PENDING)
  submittedAt       DateTime           @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?            @db.Uuid
  rejectionReason   String?
  school            School             @relation(fields: [schoolId], references: [id])

  @@index([status, submittedAt])
}

model Category {
  id        String    @id
  name      String
  icon      String?
  color     String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id             String           @id @default(uuid()) @db.Uuid
  providerId     String           @db.Uuid
  categoryId     String
  title          String
  slug           String           @unique
  description    String
  deliveryMethod DeliveryMethod   @default(ONLINE)
  campusLocation String?
  status         ServiceStatus    @default(DRAFT)
  publishedAt    DateTime?
  reviewedAt     DateTime?
  reviewedBy     String?          @db.Uuid
  rejectionReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  provider       User             @relation("ProviderServices", fields: [providerId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  packages       ServicePackage[]
  media          ServiceMedia[]
  orders         Order[]

  @@index([status, categoryId, publishedAt])
  @@index([providerId, status])
}

model ServiceMedia {
  id           String           @id @default(uuid()) @db.Uuid
  serviceId    String           @db.Uuid
  kind         ServiceMediaKind
  storagePath  String           @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  service      Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, kind, sortOrder])
}

model ServicePackage {
  id            String      @id @default(uuid()) @db.Uuid
  serviceId     String      @db.Uuid
  tier          PackageTier
  name          String
  description   String
  priceCentavos Int
  deliveryDays  Int
  revisionLimit Int         @default(0)
  isActive      Boolean     @default(true)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([serviceId, tier])
}

model Order {
  id                  String               @id @default(uuid()) @db.Uuid
  orderNumber         String               @unique
  clientId            String               @db.Uuid
  providerId          String               @db.Uuid
  serviceId           String               @db.Uuid
  servicePackageId    String               @db.Uuid
  titleSnapshot       String
  packageSnapshot     Json
  subtotalCentavos    Int
  platformFeeCentavos Int                  @default(0)
  totalCentavos       Int
  currency            String               @default("PHP")
  requirements        String
  dueAt               DateTime
  status              OrderStatus          @default(REQUESTED)
  revisionLimit       Int                  @default(0)
  revisionsUsed       Int                  @default(0)
  acceptedAt          DateTime?
  startedAt           DateTime?
  submittedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  client              User                 @relation("ClientOrders", fields: [clientId], references: [id])
  provider            User                 @relation("ProviderOrders", fields: [providerId], references: [id])
  service             Service              @relation(fields: [serviceId], references: [id])
  servicePackage      ServicePackage       @relation(fields: [servicePackageId], references: [id])
  history             OrderStatusHistory[]
  files               OrderFile[]
  conversation        Conversation?
  revisions           RevisionRequest[]
  review              Review?
  notifications       Notification[]

  @@index([clientId, status, createdAt])
  @@index([providerId, status, createdAt])
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @db.Uuid
  orderId     String?  @db.Uuid
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String       @db.Uuid
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User         @relation(fields: [changedBy], references: [id])

  @@index([orderId, createdAt])
}

model OrderFile {
  id           String              @id @default(uuid()) @db.Uuid
  orderId      String              @db.Uuid
  uploadedBy   String              @db.Uuid
  purpose      OrderFilePurpose
  storagePath  String              @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  checksum     String?
  createdAt    DateTime            @default(now())
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploader     User                @relation(fields: [uploadedBy], references: [id])
  attachments  MessageAttachment[]
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  orderId      String                    @unique @db.Uuid
  createdAt    DateTime                  @default(now())
  order        Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId    String       @db.Uuid
  userId            String       @db.Uuid
  lastReadMessageId String?      @db.Uuid
  lastReadAt        DateTime?
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @db.Uuid
  senderId       String              @db.Uuid
  body           String?
  messageType    MessageType         @default(TEXT)
  replyToId      String?             @db.Uuid
  createdAt      DateTime            @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id])
  replyTo        Message?            @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]           @relation("MessageReplies")
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  messageId   String    @db.Uuid
  orderFileId String    @db.Uuid
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  orderFile   OrderFile @relation(fields: [orderFileId], references: [id])

  @@id([messageId, orderFileId])
}

model RevisionRequest {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  requestedBy    String         @db.Uuid
  sequenceNumber Int
  instructions   String
  status         RevisionStatus @default(OPEN)
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requester      User           @relation(fields: [requestedBy], references: [id])

  @@unique([orderId, sequenceNumber])
}

model Review {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @unique @db.Uuid
  reviewerId          String   @db.Uuid
  revieweeId          String   @db.Uuid
  overallRating       Int
  qualityRating       Int?
  communicationRating Int?
  timelinessRating    Int?
  comment             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  order               Order    @relation(fields: [orderId], references: [id])
  reviewer            User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  reviewee            User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@index([revieweeId, createdAt])
}
