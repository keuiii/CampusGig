DATABASE_URL="postgresql://campusgig:campusgig@localhost:5432/campusgig?schema=public"
PORT=4000
# Address that phones on the same Wi-Fi can open for email approval links.
EMAIL_ACTION_BASE_URL=http://192.168.1.100:4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-before-production
# A separate long random value used to encrypt authenticator secrets at rest.
MFA_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
# Development/demo email without a custom domain. Use a 16-character Google
# App Password, never your normal Gmail password.
SMTP_USER=
SMTP_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=CampusGig <accounts@your-verified-domain.com>
# Comma-free OAuth client IDs accepted by the API. Configure the platforms you use.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# PayMongo sandbox only. Never expose either value to web or mobile clients.
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsk_test_replace_me
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya
PAYMENTS_REQUIRED=false
# Client-paid platform fee. 700 basis points = 7%; 1500 centavos = PHP 15.
PLATFORM_FEE_BASIS_POINTS=0
PLATFORM_FEE_MIN_CENTAVOS=0
# Public routes PayMongo returns to after checkout.
PAYMONGO_SUCCESS_URL=http://localhost:3000?payment=success&orderId={orderId}
PAYMONGO_CANCEL_URL=http://localhost:3000?payment=cancelled&orderId={orderId}
