<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CampusGig.Mobile.Models"
             xmlns:controls="clr-namespace:CampusGig.Mobile.Controls"
             x:Class="CampusGig.Mobile.Pages.OrdersPage"
             BackgroundColor="{AppThemeBinding Light=#F3F5F3, Dark=#111713}">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Style="{StaticResource MainTabHeaderStyle}">
            <Grid IsClippedToBounds="True">
                <Ellipse Style="{StaticResource MainTabHeaderAccentStyle}" />
                <VerticalStackLayout Spacing="1" VerticalOptions="Center" ZIndex="1">
                    <Label AutomationId="OrdersTitle" Text="Orders" Style="{StaticResource PageTitleStyle}" />
                    <Label Text="Track requests and provider work." Style="{StaticResource MainTabHeaderSubtitleStyle}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="44,236,44" ColumnSpacing="4" HorizontalOptions="Center">
            <Border x:Name="ScopeTabs" Grid.Column="1" IsVisible="False" Padding="4" WidthRequest="236"
                    Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}"
                    BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}" StrokeShape="RoundRectangle 15">
                <Grid ColumnDefinitions="110,110" ColumnSpacing="4" HorizontalOptions="Center">
                    <Border x:Name="ScopeIndicator" Grid.Column="0" WidthRequest="110" HeightRequest="42" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11" BackgroundColor="{AppThemeBinding Light=#08543D, Dark=#2A5B47}"
                            HorizontalOptions="Start" InputTransparent="True" />
                    <Button x:Name="ClientScopeButton" Text="My requests" CommandParameter="client" Clicked="OnScopeClicked" Pressed="OnScopePressed" Released="OnScopeReleased"
                            HeightRequest="42" CornerRadius="11" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="11" />
                    <Button x:Name="ProviderScopeButton" Grid.Column="1" Text="Provider work" CommandParameter="provider" Clicked="OnScopeClicked" Pressed="OnScopePressed" Released="OnScopeReleased"
                            HeightRequest="42" CornerRadius="11" BackgroundColor="Transparent" TextColor="#0F6B4F" FontAttributes="Bold" FontSize="11" />
                </Grid>
            </Border>
            <Border x:Name="ArchivedOrdersButton" Grid.Column="2" AutomationId="ArchivedOrdersToggle"
                    SemanticProperties.Description="View archived orders" WidthRequest="40" HeightRequest="40"
                    VerticalOptions="Center" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    BackgroundColor="#F2EED8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnArchivedOrdersClicked" />
                </Border.GestureRecognizers>
                <Path x:Name="ArchivedOrdersIcon" WidthRequest="19" HeightRequest="19" Aspect="Uniform"
                      HorizontalOptions="Center" VerticalOptions="Center" Stroke="#71663D"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                      Data="M3,5 L21,5 L21,9 L3,9 Z M5,9 L5,20 L19,20 L19,9 M9,13 L15,13" />
            </Border>
        </Grid>

        <RefreshView Grid.Row="2" x:Name="Refresh" Refreshing="OnRefreshing" RefreshColor="#0F6B4F">
            <CollectionView x:Name="OrderList" AutomationId="OrdersList" SelectionMode="None" Margin="18,0" VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,65,20,20" Spacing="12" HorizontalOptions="Center">
                        <Border WidthRequest="76" HeightRequest="76" StrokeThickness="0" StrokeShape="RoundRectangle 38"
                                BackgroundColor="{AppThemeBinding Light=#E2F0E8, Dark=#203B30}" HorizontalOptions="Center">
                            <Grid WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center">
                                <Path Aspect="Uniform" Stroke="#08543D" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Data="M4,7 L20,7 L20,20 L4,20 Z M9,7 L9,4 L15,4 L15,7 M4,11 C8,13 16,13 20,11" />
                                <Path Aspect="Uniform" Stroke="#08543D" StrokeThickness="1.8" StrokeLineCap="Round"
                                      Data="M12,11 L12,14" />
                            </Grid>
                        </Border>
                        <Label x:Name="EmptyOrdersTitle" Text="No orders yet" FontSize="19" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label x:Name="EmptyOrdersDescription" Text="Choose a published student service and send your first project request." FontSize="12" LineHeight="1.35"
                               HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Button x:Name="BrowseServicesButton" Text="Browse services" Clicked="OnBrowseClicked" Margin="0,12,0,0" WidthRequest="180" HeightRequest="46"
                                BackgroundColor="#08543D" TextColor="White" CornerRadius="13" FontAttributes="Bold" FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,4,0,24">
                        <Button x:Name="LoadMoreOrdersButton" AutomationId="LoadMoreOrdersButton" IsVisible="False"
                                Text="Load more orders" Clicked="OnLoadMoreOrdersClicked"
                                HorizontalOptions="Center" WidthRequest="190" HeightRequest="44" CornerRadius="13"
                                BackgroundColor="{AppThemeBinding Light=#E2F0E8, Dark=#244035}"
                                TextColor="{AppThemeBinding Light=#08543D, Dark=#91DABD}" FontAttributes="Bold" FontSize="12" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:OrderItem">
                        <Border AutomationId="OrderCard" Margin="0,0,0,12" Padding="15" Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}"
                                StrokeShape="RoundRectangle 17" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8" ColumnDefinitions="*">
                            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="42,*,Auto" RowSpacing="8" ColumnSpacing="10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOrderTapped" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.RowSpan="2" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                        BackgroundColor="{AppThemeBinding Light=#E7F1EC, Dark=#244035}" VerticalOptions="Start">
                                    <Grid WidthRequest="21" HeightRequest="21" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Path Aspect="Uniform" Stroke="#0F6B4F" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                              Data="M4,7 L20,7 L20,20 L4,20 Z M9,7 L9,4 L15,4 L15,7 M4,11 C8,13 16,13 20,11" />
                                        <Path Aspect="Uniform" Stroke="#0F6B4F" StrokeThickness="1.8" StrokeLineCap="Round"
                                              Data="M12,11 L12,14" />
                                    </Grid>
                                </Border>
                                <Label Grid.Column="1" AutomationId="OrderNumberLabel" Text="{Binding OrderNumberLabel}" FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"
                                       CharacterSpacing="0.65" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0A6A4E, Dark=#80D7B5}" VerticalTextAlignment="Center" />
                                <HorizontalStackLayout Grid.Column="2" Spacing="5">
                                    <Border Padding="9,4" StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light=#DDF1E7, Dark=#244035}" StrokeShape="RoundRectangle 11">
                                        <Label Text="{Binding StatusLabel}" FontSize="8" CharacterSpacing="0.5" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#71D7B1}" />
                                    </Border>
                                    <Border IsVisible="{Binding HasPaymentStatus}" Padding="9,4"
                                            Stroke="{AppThemeBinding Light=#B9DCCB, Dark=#3C6654}" StrokeThickness="1"
                                            BackgroundColor="{AppThemeBinding Light=#EDF8F2, Dark=#173429}" StrokeShape="RoundRectangle 11">
                                        <Label Text="{Binding PaymentStatusLabel}" FontSize="8" CharacterSpacing="0.5" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#087A5A, Dark=#80E0BC}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Title}" FontAttributes="Bold" FontSize="18"
                                       MaxLines="2" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" LineBreakMode="WordWrap" />
                                <Border Grid.Row="2" Grid.ColumnSpan="3" Padding="11,9" StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                        BackgroundColor="{AppThemeBinding Light=#EEF6F2, Dark=#192A22}">
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                                        <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" StrokeShape="RoundRectangle 17"
                                                BackgroundColor="{AppThemeBinding Light=#D7ECE2, Dark=#284839}">
                                            <Grid>
                                                <Label Text="{Binding RelationshipInitial}" FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#075B42, Dark=#91DABD}"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                <Image Source="{Binding RelationshipAvatarUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding RelationshipRole}" FontSize="8" CharacterSpacing="1.05" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#4D7565, Dark=#82B49F}" />
                                            <Label Text="{Binding RelationshipName}" FontSize="13" FontAttributes="Bold" MaxLines="1"
                                                   TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="3" Grid.ColumnSpan="3" ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="13,12"
                                      BackgroundColor="{AppThemeBinding Light=#F5F8F6, Dark=#151D19}">
                                    <VerticalStackLayout Spacing="4"><Label Text="PACKAGE" FontSize="8" CharacterSpacing="0.8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}"/><Label Text="{Binding Package.Name}" FontAttributes="Bold" FontSize="10" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" LineBreakMode="TailTruncation"/></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="TOTAL" FontSize="8" CharacterSpacing="0.8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}"/><Label Text="{Binding PriceLabel}" FontAttributes="Bold" FontSize="10" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}"/></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="4"><Label Text="{Binding DeliveryDateHeading}" FontSize="8" CharacterSpacing="0.8" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}"/><Label Text="{Binding DeliveryDateLabel}" FontAttributes="Bold" FontSize="10" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}"/></VerticalStackLayout>
                                </Grid>
                            </Grid>
                            <SwipeView Grid.Row="1" HorizontalOptions="Fill" IsVisible="{Binding IsCompleted}" Threshold="80"
                                       SwipeChanging="OnOrderSwipeChanging" SwipeEnded="OnOrderSwipeEnded">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                        <SwipeItemView WidthRequest="80">
                                            <HorizontalStackLayout WidthRequest="80" HeightRequest="36" Spacing="4" HorizontalOptions="End">
                                                <Border WidthRequest="38" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                                        BackgroundColor="#E6F2E9" SemanticProperties.Description="{Binding ArchiveActionLabel}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnArchiveOrderTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path WidthRequest="17" HeightRequest="17" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"
                                                          Stroke="#0F6B4F" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M3,5 L21,5 L21,9 L3,9 Z M5,9 L5,20 L19,20 L19,9 M9,13 L15,13" />
                                                </Border>
                                                <Border WidthRequest="38" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                                        BackgroundColor="#FBE9E5" SemanticProperties.Description="Remove order from your list">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnRemoveOrderTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path WidthRequest="17" HeightRequest="17" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"
                                                          Stroke="#B94739" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 L17,20 L18,7 M10,10 L10,17 M14,10 L14,17" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Grid ColumnDefinitions="*,Auto" HeightRequest="38" HorizontalOptions="Fill">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOrderTapped" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="Swipe left" FontSize="9" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="Open workspace" FontSize="11" FontAttributes="Bold" TextColor="#0F6B4F" />
                                </Grid>
                            </SwipeView>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" HeightRequest="44">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding Status}" Value="COMPLETED">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Grid.Triggers>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOrderTapped" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Text="View details and project activity" FontSize="9" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Open workspace" FontSize="11" FontAttributes="Bold" TextColor="#0F6B4F" VerticalTextAlignment="Center" />
                            </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout x:Name="LoadingOrders" Grid.Row="2" IsVisible="False" Margin="18,8,18,0"
                             Spacing="12" VerticalOptions="Start" SemanticProperties.Description="Loading orders">
            <controls:SkeletonCard Kind="Order" />
            <controls:SkeletonCard Kind="Order" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
