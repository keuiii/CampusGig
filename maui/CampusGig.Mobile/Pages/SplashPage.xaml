<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusGig.Mobile.Pages.SplashPage"
             BackgroundColor="{AppThemeBinding Light=#F7F8F3, Dark=#111713}"
             InputTransparent="True">
    <Grid x:Name="SplashContent" Padding="26,48" IsClippedToBounds="True">
        <Grid InputTransparent="True">
            <Ellipse x:Name="TopOrb" WidthRequest="270" HeightRequest="270" HorizontalOptions="End" VerticalOptions="Start"
                     TranslationX="128" TranslationY="-135" Scale="0.75" Opacity="0"
                     Fill="{AppThemeBinding Light=#E4EFC8, Dark=#1B352A}" />
            <Ellipse x:Name="BottomOrb" WidthRequest="315" HeightRequest="315" HorizontalOptions="Start" VerticalOptions="End"
                     TranslationX="-165" TranslationY="155" Scale="0.8" Opacity="0"
                     Fill="{AppThemeBinding Light=#DCECE4, Dark=#183126}" />
        </Grid>

        <Grid WidthRequest="350" HeightRequest="430" HorizontalOptions="Center" VerticalOptions="Center">
            <Ellipse x:Name="ParticleOne" WidthRequest="9" HeightRequest="9" Fill="#D9F36A" HorizontalOptions="Center" VerticalOptions="Center" TranslationX="-104" TranslationY="-84" Opacity="0" Scale="0.2" />
            <Ellipse x:Name="ParticleTwo" WidthRequest="7" HeightRequest="7" Fill="#71D7B1" HorizontalOptions="Center" VerticalOptions="Center" TranslationX="111" TranslationY="-62" Opacity="0" Scale="0.2" />
            <Ellipse x:Name="ParticleThree" WidthRequest="6" HeightRequest="6" Fill="#0F6B4F" HorizontalOptions="Center" VerticalOptions="Center" TranslationX="-126" TranslationY="31" Opacity="0" Scale="0.2" />
            <Ellipse x:Name="ParticleFour" WidthRequest="10" HeightRequest="10" Fill="#D9F36A" HorizontalOptions="Center" VerticalOptions="Center" TranslationX="128" TranslationY="44" Opacity="0" Scale="0.2" />
            <Ellipse x:Name="ParticleFive" WidthRequest="5" HeightRequest="5" Fill="#71D7B1" HorizontalOptions="Center" VerticalOptions="Center" TranslationX="-74" TranslationY="101" Opacity="0" Scale="0.2" />
            <Ellipse x:Name="ParticleSix" WidthRequest="7" HeightRequest="7" Fill="#0F6B4F" HorizontalOptions="Center" VerticalOptions="Center" TranslationX="82" TranslationY="105" Opacity="0" Scale="0.2" />

            <VerticalStackLayout VerticalOptions="Center" Spacing="18">
                <Grid x:Name="BrandMark" WidthRequest="190" HeightRequest="190" HorizontalOptions="Center"
                      Opacity="0" Scale="0.55" TranslationY="28">
                    <Image Source="campusgig_mark.svg" WidthRequest="190" HeightRequest="190"
                           Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center"
                           SemanticProperties.Description="CampusGig logo" />
                </Grid>

                <Grid HeightRequest="65" HorizontalOptions="Center">
                    <HorizontalStackLayout x:Name="Wordmark" Spacing="0" Padding="8,0"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label x:Name="LetterC" Text="C" Style="{StaticResource SplashCampusLetter}" />
                        <Label x:Name="LetterA" Text="a" Style="{StaticResource SplashCampusLetter}" />
                        <Label x:Name="LetterM" Text="m" Style="{StaticResource SplashCampusLetter}" />
                        <Label x:Name="LetterP" Text="p" Style="{StaticResource SplashCampusLetter}" />
                        <Label x:Name="LetterU" Text="u" Style="{StaticResource SplashCampusLetter}" />
                        <Label x:Name="LetterS" Text="s" Style="{StaticResource SplashCampusLetter}" Margin="0,0,3,0" />
                        <Label x:Name="LetterG" Text="G" Style="{StaticResource SplashGigLetter}" />
                        <Label x:Name="LetterI" Text="i" Style="{StaticResource SplashGigLetter}" />
                        <Label x:Name="LetterG2" Text="g" Style="{StaticResource SplashGigLetter}" />
                    </HorizontalStackLayout>
                </Grid>

                <VerticalStackLayout x:Name="MessageGroup" Spacing="7" Opacity="0" TranslationY="14">
                    <Label Text="STUDENT SKILLS. REAL OPPORTUNITIES" HorizontalTextAlignment="Center"
                           FontSize="9" CharacterSpacing="2" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#087A5A, Dark=#71D7B1}" />
                    <Border x:Name="AccentLine" WidthRequest="128" HeightRequest="4"
                            HorizontalOptions="Center" BackgroundColor="#B9E64A"
                            StrokeThickness="0" StrokeShape="RoundRectangle 2"
                            Opacity="0" TranslationY="4" />
                    <Label Text="Learn  •  Share  •  Grow" HorizontalTextAlignment="Center" FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#58645E, Dark=#AAB6AF}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>

    <ContentPage.Resources>
        <Style x:Key="SplashCampusLetter" TargetType="Label">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="CharacterSpacing" Value="-0.8" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#12362C, Dark=#F2F6F3}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslationY" Value="30" />
            <Setter Property="Scale" Value="0.72" />
        </Style>
        <Style x:Key="SplashGigLetter" TargetType="Label" BasedOn="{StaticResource SplashCampusLetter}">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#087A5A, Dark=#71D7B1}" />
        </Style>
    </ContentPage.Resources>
</ContentPage>
