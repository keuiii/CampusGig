<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CampusGig.Mobile.Models"
             x:Class="CampusGig.Mobile.Pages.HomePage"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111713}">
    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing" RefreshColor="#0F6B4F">
        <ScrollView>
            <VerticalStackLayout Padding="0,10,0,34" Spacing="0">
                <Grid x:Name="HeaderArea" Padding="22,10,22,16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="WELCOME TO" FontSize="9" CharacterSpacing="1.6" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Label FontSize="25" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Campus" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                                    <Span Text="Gig" TextColor="#0F6B4F" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                    <Grid x:Name="NotificationButton" Grid.Column="1" WidthRequest="48" HeightRequest="48">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationsClicked"/></Grid.GestureRecognizers>
                        <Border WidthRequest="42" HeightRequest="42" HorizontalOptions="Start" VerticalOptions="End"
                                StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E1EEE7, Dark=#203B30}"
                                StrokeShape="RoundRectangle 21">
                            <Grid WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center">
                                <Path Aspect="Uniform" Stroke="{AppThemeBinding Light=#173D31, Dark=#D8E8E0}" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Data="M18,8 C18,4.6863 15.3137,2 12,2 C8.6863,2 6,4.6863 6,8 C6,15 3,15 3,17 L21,17 C21,15 18,15 18,8" />
                                <Path Aspect="Uniform" Stroke="{AppThemeBinding Light=#173D31, Dark=#D8E8E0}" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeLineJoin="Round" Data="M10,21 L14,21" />
                            </Grid>
                        </Border>
                        <Border x:Name="NotificationBadge" IsVisible="False" MinimumWidthRequest="18" HeightRequest="18" Padding="4,0"
                                HorizontalOptions="End" VerticalOptions="Start" StrokeThickness="2"
                                Stroke="{AppThemeBinding Light=#FFFFFF, Dark=#111713}"
                                BackgroundColor="#D95045" StrokeShape="RoundRectangle 9" ZIndex="4">
                            <Label x:Name="NotificationCountLabel" FontSize="8" FontAttributes="Bold" TextColor="White"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Border x:Name="ProfileShortcutButton" Grid.Column="2" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#E1EEE7, Dark=#203B30}" StrokeShape="RoundRectangle 21">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileClicked" /></Border.GestureRecognizers>
                        <Grid IsClippedToBounds="True">
                            <Label x:Name="ProfileInitialsLabel" FontSize="15" FontAttributes="Bold" TextColor="#0F6B4F"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Image x:Name="ProfileShortcutImage" Aspect="AspectFill" IsVisible="False" ZIndex="2" />
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="HeroCard" Margin="15,0" Padding="24,28,24,24" StrokeThickness="0" StrokeShape="RoundRectangle 24"
                        BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" IsClippedToBounds="True">
                        <Ellipse Grid.RowSpan="4" WidthRequest="170" HeightRequest="170" HorizontalOptions="End"
                                 VerticalOptions="Start" TranslationX="70" TranslationY="-66" Fill="{AppThemeBinding Light=#E4EFC0, Dark=#244035}" />
                        <Label Text="STUDENT SKILLS, REAL OPPORTUNITIES" FontSize="9" CharacterSpacing="1.3"
                               FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label Grid.Row="1" Margin="0,10,0,0" Text="What do you need help with today?" FontSize="31"
                               LineHeight="1.18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label Grid.Row="2" Margin="0,10,0,0" Text="Find trusted services from verified students in your campus community."
                               FontSize="13" LineHeight="1.45" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Border Grid.Row="3" Margin="0,22,0,0" HeightRequest="56" Padding="13,0" Stroke="#E3E7E4"
                                StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                            <Grid ColumnDefinitions="32,*">
                                <Label Text="⌕" FontSize="27" TextColor="#0F6B4F" VerticalTextAlignment="Center" />
                                <Entry x:Name="SearchBox" Grid.Column="1" Placeholder="Search student services"
                                       TextChanged="OnFilterChanged" FontSize="13" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="SchoolSection" Margin="0,24,0,0" Spacing="8" IsVisible="False">
                    <Label Text="PREFERRED SCHOOL" Margin="22,0" FontSize="9" CharacterSpacing="1.5"
                           FontAttributes="Bold" TextColor="#0F6B4F" />
                    <Label x:Name="SchoolCountLabel" Margin="22,0" FontSize="11"
                           TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                    <CollectionView x:Name="SchoolList" HeightRequest="48" SelectionMode="Single"
                                    SelectionChanged="OnSchoolSelected" Margin="22,0,0,0">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="9" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SchoolItem">
                                <Border Padding="15,9" Margin="0,0,0,2" Stroke="#DDE4DF" StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#0F6B4F" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label Text="{Binding ShortName}" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Grid x:Name="CategoryHeader" IsVisible="False" Margin="22,28,22,14" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                    <Label Text="EXPLORE" FontSize="9" CharacterSpacing="1.5" FontAttributes="Bold" TextColor="#0F6B4F" />
                    <Label Grid.Row="1" Text="Browse categories" FontSize="22" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                    <Button x:Name="ClearCategoryButton" Grid.RowSpan="2" Grid.Column="1" Text="Clear" IsVisible="False"
                            Clicked="OnClearCategoryClicked" BackgroundColor="Transparent" TextColor="#0F6B4F"
                            FontSize="12" FontAttributes="Bold" Padding="12,8" VerticalOptions="End" />
                </Grid>
                <CollectionView x:Name="CategoryList" IsVisible="False" HeightRequest="158" SelectionMode="Single"
                                SelectionChanged="OnCategorySelected" Margin="22,0,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="11" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryItem">
                            <Border WidthRequest="132" Padding="14" Stroke="#E3E7E4" StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C2520}">
                                <VerticalStackLayout>
                                    <Border WidthRequest="43" HeightRequest="43" HorizontalOptions="Start" StrokeThickness="0"
                                            BackgroundColor="{Binding IconBackground}" StrokeShape="RoundRectangle 11">
                                        <Label Text="{Binding IconGlyph}" TextColor="{Binding IconColor}" FontSize="14"
                                               FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Text="{Binding Name}" Margin="0,18,0,0" FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                                    <Label Text="{Binding CountLabel}" Margin="0,4,0,0" FontSize="10"
                                           TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid x:Name="MarketplaceHeader" Margin="22,29,22,15" RowDefinitions="Auto,Auto">
                    <Label Text="MARKETPLACE" FontSize="9" CharacterSpacing="1.5" FontAttributes="Bold" TextColor="#0F6B4F" />
                    <Label x:Name="MarketplaceTitleLabel" Grid.Row="1" Text="Available services" FontSize="22" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                </Grid>
                <VerticalStackLayout x:Name="ServiceCards" BindableLayout.ItemsSource="{Binding FilteredServices}"
                                     Spacing="14" Margin="22,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ServiceItem">
                            <Border Padding="0" Stroke="#E3E7E4" StrokeShape="RoundRectangle 17"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C2520}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnServiceTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="0">
                                    <Grid HeightRequest="112" BackgroundColor="{AppThemeBinding Light=#E4F0E9, Dark=#203B30}">
                                        <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill" />
                                        <Label Text="◇" FontSize="42" TextColor="#0F6B4F" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Grid>
                                    <VerticalStackLayout Padding="17" Spacing="7">
                                        <Label Text="{Binding Category}" FontSize="9" CharacterSpacing="1" FontAttributes="Bold" TextColor="#0F6B4F" />
                                        <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                                        <HorizontalStackLayout Spacing="7">
                                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                                    BackgroundColor="{AppThemeBinding Light=#E1EEE7, Dark=#203B30}">
                                                <Grid>
                                                    <Image Source="{Binding ProviderAvatarUrl}" Aspect="AspectFill" />
                                                    <Label Text="{Binding ProviderInitial}" FontSize="9" FontAttributes="Bold" TextColor="#0F6B4F"
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Label Text="{Binding ProviderLabel}" FontSize="10" VerticalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                        </HorizontalStackLayout>
                                        <BoxView HeightRequest="1" Margin="0,7,0,3" Color="{AppThemeBinding Light=#EDF0EE, Dark=#34423A}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label FontSize="11" TextColor="#D18E13">
                                                <Label.FormattedText><FormattedString><Span Text="★ "/><Span Text="{Binding Rating}"/></FormattedString></Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding PriceLabel}" FontSize="12" FontAttributes="Bold" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border x:Name="LoadingServices" IsVisible="False" Margin="22,0" Padding="28,34" Stroke="#E3E7E4"
                        StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light=#FBFCFB, Dark=#1C2520}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <ActivityIndicator IsRunning="True" Color="#0F6B4F" />
                        <Label Text="Connecting to CampusGig" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Loading real marketplace data." FontSize="11" TextColor="#66716B" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="EmptyServices" IsVisible="False" Margin="22,0" Padding="28,34" Stroke="#E3E7E4"
                        StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light=#FBFCFB, Dark=#1C2520}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="◇" FontSize="38" TextColor="#0F6B4F" HorizontalTextAlignment="Center" />
                        <Label Text="No services found" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Try another school, category, or search." FontSize="11" TextColor="#66716B" HorizontalTextAlignment="Center" />
                        <Button Text="Clear filters" Clicked="OnClearFiltersClicked" Margin="0,8,0,0"
                                BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#1D4537}"
                                TextColor="{AppThemeBinding Light=#08543D, Dark=#91DABD}"
                                CornerRadius="12" HeightRequest="42" Padding="18,0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
