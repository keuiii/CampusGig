<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CampusGig.Mobile.Models"
             xmlns:controls="clr-namespace:CampusGig.Mobile.Controls"
             x:Class="CampusGig.Mobile.Pages.HomePage"
             BackgroundColor="{AppThemeBinding Light=#F3F5F3, Dark=#111713}">
    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing" RefreshColor="#0F6B4F">
        <CollectionView x:Name="ServiceCards" ItemsSource="{Binding FilteredServices}"
                        SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,10,0,0" Spacing="0">
                <Grid x:Name="HeaderArea" AutomationId="DiscoverPage" Padding="20,8,20,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="WELCOME TO" FontSize="9" CharacterSpacing="1.6" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Label FontSize="25" FontFamily="OpenSansSemibold" FontAttributes="Bold" CharacterSpacing="-0.8">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Campus" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                                    <Span Text="Gig" TextColor="#0F6B4F" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                    <Grid x:Name="NotificationButton" AutomationId="NotificationsBell" Grid.Column="1" WidthRequest="48" HeightRequest="48"
                          SemanticProperties.Description="Open notifications">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationsClicked"/></Grid.GestureRecognizers>
                        <Border WidthRequest="42" HeightRequest="42" HorizontalOptions="Start" VerticalOptions="End"
                                StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E1EEE7, Dark=#203B30}"
                                StrokeShape="RoundRectangle 21">
                            <Path x:Name="NotificationBellIcon" AutomationId="NotificationBellIcon"
                                  WidthRequest="22" HeightRequest="23" Aspect="Uniform"
                                  Stroke="{AppThemeBinding Light=#173D31, Dark=#D8E8E0}" StrokeThickness="1.85"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Data="M12,3 C8.7,3 6,5.7 6,9 L6,12.5 C6,14.4 5.35,15.8 4,17.2 C3.6,17.65 3.9,18.35 4.55,18.35 L19.45,18.35 C20.1,18.35 20.4,17.65 20,17.2 C18.65,15.8 18,14.4 18,12.5 L18,9 C18,5.7 15.3,3 12,3 Z M9.6,20.25 C10.15,21.35 10.95,22 12,22 C13.05,22 13.85,21.35 14.4,20.25" />
                        </Border>
                        <Border x:Name="NotificationBadge" IsVisible="False" MinimumWidthRequest="18" HeightRequest="18" Padding="4,0"
                                HorizontalOptions="End" VerticalOptions="Start" StrokeThickness="2"
                                Stroke="{AppThemeBinding Light=#FFFFFF, Dark=#111713}"
                                BackgroundColor="#D95045" StrokeShape="RoundRectangle 9" ZIndex="4">
                            <Label x:Name="NotificationCountLabel" FontSize="8" FontAttributes="Bold" TextColor="White"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Border x:Name="ProfileShortcutButton" Grid.Column="2" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#E1EEE7, Dark=#203B30}" StrokeShape="RoundRectangle 21">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileClicked" /></Border.GestureRecognizers>
                        <Grid IsClippedToBounds="True">
                            <Label x:Name="ProfileInitialsLabel" FontSize="15" FontAttributes="Bold" TextColor="#0F6B4F"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Image x:Name="ProfileShortcutImage" Aspect="AspectFill" IsVisible="False" ZIndex="2" />
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="HeroCard" Margin="20,0" Padding="18,20,18,18" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" IsClippedToBounds="True">
                        <Ellipse Grid.RowSpan="4" WidthRequest="170" HeightRequest="170" HorizontalOptions="End"
                                 VerticalOptions="Start" TranslationX="70" TranslationY="-66" Fill="{AppThemeBinding Light=#E4EFC0, Dark=#244035}" />
                        <Label Text="STUDENT SKILLS, REAL OPPORTUNITIES" FontSize="9" CharacterSpacing="1.3"
                               FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label Grid.Row="1" Margin="0,7,0,0" Text="What do you need help with today?" FontSize="27"
                               LineHeight="1.18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label Grid.Row="2" Margin="0,7,0,0" Text="Find trusted services from verified students in your campus community."
                               FontSize="13" LineHeight="1.45" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Border Grid.Row="3" Margin="0,14,0,0" HeightRequest="48" Padding="12,0" Stroke="#E3E7E4"
                                StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                            <Grid ColumnDefinitions="32,*,36">
                                <Path WidthRequest="19" HeightRequest="19" Aspect="Uniform" Stroke="#0F6B4F" StrokeThickness="1.8"
                                      StrokeLineCap="Round" StrokeLineJoin="Round" HorizontalOptions="Center" VerticalOptions="Center"
                                      Data="M21,21 L16.65,16.65 M19,11 C19,15.4183 15.4183,19 11,19 C6.5817,19 3,15.4183 3,11 C3,6.5817 6.5817,3 11,3 C15.4183,3 19,6.5817 19,11 Z" />
                                <Entry x:Name="SearchBox" AutomationId="SearchServices" Grid.Column="1" Placeholder="Search student services" MaxLength="120"
                                       TextChanged="OnFilterChanged" FontSize="13" />
                                <Button x:Name="ClearSearchButton" AutomationId="ClearServiceSearch" Grid.Column="2"
                                        Text="&#x00D7;" IsVisible="False" Clicked="OnClearSearchClicked"
                                        SemanticProperties.Description="Clear service search"
                                        FontSize="21" Padding="0" WidthRequest="36" HeightRequest="44"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="SchoolSection" Margin="0,18,0,0" Spacing="7" IsVisible="False">
                    <Label Text="PREFERRED SCHOOL" Margin="20,0" FontSize="9" CharacterSpacing="1.5"
                           FontAttributes="Bold" TextColor="#0F6B4F" />
                    <Label x:Name="SchoolCountLabel" Margin="20,0" FontSize="11"
                           TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                    <CollectionView x:Name="SchoolList" HeightRequest="40" SelectionMode="Single"
                                    SelectionChanged="OnSchoolSelected" Margin="20,0"
                                    HorizontalOptions="Start" HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SchoolItem">
                                <Border x:Name="SchoolChip" Padding="13,6" Margin="0" MinimumHeightRequest="36"
                                        VerticalOptions="Center" Stroke="#DDE4DF" StrokeShape="RoundRectangle 18"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#DFF2E8" />
                                                    <Setter Property="Stroke" Value="#B9DDCA" />
                                                    <Setter TargetName="SchoolChipLabel" Property="Label.TextColor" Value="#08543D" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label x:Name="SchoolChipLabel" Text="{Binding ShortName}" FontSize="11"
                                           FontAttributes="Bold" LineBreakMode="NoWrap"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#24332C, Dark=#EAF2ED}" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Grid x:Name="CategoryHeader" IsVisible="False" Margin="20,22,20,11" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                    <Label Text="EXPLORE" FontSize="9" CharacterSpacing="1.5" FontAttributes="Bold" TextColor="#0F6B4F" />
                    <Label Grid.Row="1" Text="Browse categories" FontSize="22" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                    <Button x:Name="ClearCategoryButton" Grid.RowSpan="2" Grid.Column="1" Text="Clear" IsVisible="False"
                            Clicked="OnClearCategoryClicked" BackgroundColor="Transparent" TextColor="#0F6B4F"
                            FontSize="12" FontAttributes="Bold" Padding="12,8" VerticalOptions="End" />
                </Grid>
                <CollectionView x:Name="CategoryList" IsVisible="False" HeightRequest="142" SelectionMode="None"
                                Margin="20,0,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="11" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryItem">
                            <Border WidthRequest="132" Padding="14" Stroke="#E3E7E4" StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C2520}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Border WidthRequest="43" HeightRequest="43" HorizontalOptions="Start" StrokeThickness="0"
                                            BackgroundColor="{Binding IconBackground}" StrokeShape="RoundRectangle 11">
                                        <Label Text="{Binding IconGlyph}" TextColor="{Binding IconColor}" FontSize="14"
                                               FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Text="{Binding Name}" Margin="0,18,0,0" FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                                    <Label Text="{Binding CountLabel}" Margin="0,4,0,0" FontSize="10"
                                           TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid x:Name="MarketplaceHeader" Margin="20,22,20,11" RowDefinitions="Auto,Auto">
                    <Label Text="MARKETPLACE" FontSize="9" CharacterSpacing="1.5" FontAttributes="Bold" TextColor="#0F6B4F" />
                    <Label x:Name="MarketplaceTitleLabel" AutomationId="DiscoverTitle" Grid.Row="1" Text="Available services" FontSize="22" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                </Grid>
                <Grid Margin="20,0,20,10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label x:Name="MarketplaceResultCountLabel" Text="0 services" FontSize="11"
                           TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}"
                           VerticalTextAlignment="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Button x:Name="SavedServicesButton" AutomationId="SavedServicesButton" Text="Saved" Clicked="OnSavedServicesClicked"
                            HeightRequest="40" Padding="14,0" CornerRadius="12" FontSize="11" FontAttributes="Bold"
                            BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#1D4537}"
                            TextColor="{AppThemeBinding Light=#08543D, Dark=#91DABD}" />
                    <Button x:Name="MarketplaceFiltersButton" AutomationId="MarketplaceFiltersButton"
                            Text="Filters" Clicked="OnMarketplaceFiltersClicked" HeightRequest="40" Padding="14,0"
                            CornerRadius="12" FontSize="11" FontAttributes="Bold"
                            BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#1D4537}"
                            TextColor="{AppThemeBinding Light=#08543D, Dark=#91DABD}" />
                    </HorizontalStackLayout>
                </Grid>
                <Border x:Name="MarketplaceFiltersPanel" AutomationId="MarketplaceFiltersPanel" IsVisible="False"
                        Margin="22,0,22,18" Padding="16" Stroke="{AppThemeBinding Light=#DDE6E1, Dark=#34423A}"
                        StrokeShape="RoundRectangle 17" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C2520}">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="REFINE SERVICES" FontSize="9" CharacterSpacing="1.3" FontAttributes="Bold" TextColor="#0F6B4F" />
                                <Label Text="Choose only what matters for this request." FontSize="11"
                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Clear" Clicked="OnClearAdvancedFiltersClicked"
                                    BackgroundColor="Transparent" TextColor="#0F6B4F" FontSize="11" FontAttributes="Bold" Padding="10,4" />
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="BUDGET RANGE" FontSize="8" CharacterSpacing="1" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                <Picker x:Name="BudgetRangePicker" AutomationId="BudgetRangeFilter"
                                        SelectedIndexChanged="OnAdvancedFilterChanged" HeightRequest="46" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="MINIMUM RATING" FontSize="8" CharacterSpacing="1" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                <Picker x:Name="MinimumRatingPicker" AutomationId="MinimumRatingFilter"
                                        SelectedIndexChanged="OnAdvancedFilterChanged" HeightRequest="46" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="6">
                                <Label Text="DELIVERY TIME" FontSize="8" CharacterSpacing="1" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                <Picker x:Name="MaximumDeliveryPicker" AutomationId="MaximumDeliveryFilter"
                                        SelectedIndexChanged="OnAdvancedFilterChanged" HeightRequest="46" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Label Text="SORT SERVICES" FontSize="8" CharacterSpacing="1" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                <Picker x:Name="MarketplaceSortPicker" AutomationId="MarketplaceSortFilter"
                                        SelectedIndexChanged="OnAdvancedFilterChanged" HeightRequest="46" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ServiceItem">
                            <Border AutomationId="ServiceCard" Margin="20,0" Padding="0" Stroke="#DDE6E1" StrokeShape="RoundRectangle 17"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C2520}">
                                <VerticalStackLayout Spacing="0">
                                    <Grid HeightRequest="108" BackgroundColor="{AppThemeBinding Light=#E4F0E9, Dark=#203B30}">
                                        <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnServiceTapped" CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <Button AutomationId="SaveServiceButton" Text="{Binding SaveLabel}" CommandParameter="{Binding .}" Clicked="OnSaveServiceClicked"
                                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,10,0"
                                                WidthRequest="40" HeightRequest="40" Padding="0" CornerRadius="20"
                                                FontSize="24" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#203B30}"
                                                TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#91DABD}" />
                                        <Grid IsVisible="{Binding ShowCoverPlaceholder}" WidthRequest="38" HeightRequest="38"
                                              HorizontalOptions="Center" VerticalOptions="Center">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnServiceTapped" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Path Aspect="Uniform" Stroke="#0F6B4F" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M3,5 L21,5 L21,19 L3,19 Z M3,16 L8,11 L12,15 L15,12 L21,18 M16,9 C16,8.4477 16.4477,8 17,8 C17.5523,8 18,8.4477 18,9 C18,9.5523 17.5523,10 17,10 C16.4477,10 16,9.5523 16,9 Z" />
                                        </Grid>
                                    </Grid>
                                    <VerticalStackLayout Padding="15,11,15,13" Spacing="7">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnServiceTapped" CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Border HorizontalOptions="Start" Padding="9,4" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="{AppThemeBinding Light=#E8F4EE, Dark=#244035}">
                                                <Label Text="{Binding Category}" FontSize="8" CharacterSpacing="1" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#087052, Dark=#8BE0BE}" />
                                            </Border>
                                            <Border Grid.Column="1" Padding="9,4" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="{AppThemeBinding Light=#F1F3EF, Dark=#29342E}">
                                                <Label Text="{Binding DeliveryLabel}" FontSize="8" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#59655F, Dark=#B5C0BA}" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding Title}" FontSize="18" LineHeight="1.16" FontAttributes="Bold" MaxLines="2"
                                               TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                                        <Grid ColumnDefinitions="22,*,15" ColumnSpacing="7">
                                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                                    BackgroundColor="{AppThemeBinding Light=#E1EEE7, Dark=#203B30}">
                                                <Grid>
                                                    <Image Source="{Binding ProviderAvatarUrl}" Aspect="AspectFill" />
                                                    <Label Text="{Binding ProviderInitial}" FontSize="9" FontAttributes="Bold" TextColor="#0F6B4F"
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding ProviderLabel}" FontSize="10" VerticalTextAlignment="Center"
                                                   MaxLines="1" LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                            <Border Grid.Column="2" WidthRequest="15" HeightRequest="15" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="#087A5A" VerticalOptions="Center">
                                                <Path WidthRequest="9" HeightRequest="9" Aspect="Uniform" Stroke="White" StrokeThickness="2.2"
                                                      StrokeLineCap="Round" StrokeLineJoin="Round" Data="M4,8 L7,11 L13,5"
                                                      HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <BoxView HeightRequest="1" Margin="0,5,0,2" Color="{AppThemeBinding Light=#EDF0EE, Dark=#34423A}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Path WidthRequest="15" HeightRequest="15" Aspect="Uniform" Fill="#E6A72B" Stroke="#E6A72B" StrokeThickness="1"
                                                      Data="M12,2 L15.1,8.3 L22,9.3 L17,14.2 L18.2,21 L12,17.8 L5.8,21 L7,14.2 L2,9.3 L8.9,8.3 Z" />
                                                <Label Text="{Binding RatingLabel}" FontSize="12" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#4A554F, Dark=#D5DFDA}" VerticalTextAlignment="Center" />
                                            </HorizontalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                                <Label Text="{Binding PriceContextLabel}" FontSize="7" CharacterSpacing="0.9" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#7A8580, Dark=#93A49B}" HorizontalTextAlignment="End" />
                                                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                                    <Label Text="{Binding PriceAmountLabel}" FontSize="16" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#075B42, Dark=#8BE0BE}" VerticalTextAlignment="Center" />
                                                    <Border IsVisible="{Binding IsFixedPrice}" WidthRequest="22" HeightRequest="22" Padding="4"
                                                            StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                                            BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#244035}"
                                                            SemanticProperties.Description="Fixed price">
                                                        <Path Aspect="Uniform" Stroke="{AppThemeBinding Light=#087A5A, Dark=#8BE0BE}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                              Data="M7,10 L7,7 C7,4.2 9.2,2 12,2 C14.8,2 17,4.2 17,7 L17,10 M5,10 L19,10 L19,21 L5,21 Z" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <VerticalStackLayout Padding="0,0,0,34" Spacing="14">
                <Button x:Name="LoadMoreServicesButton" AutomationId="LoadMoreServicesButton"
                        Text="Show more services" IsVisible="False" Clicked="OnLoadMoreServicesClicked"
                        Margin="22,0" HeightRequest="46" CornerRadius="13"
                        BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#1D4537}"
                        TextColor="{AppThemeBinding Light=#08543D, Dark=#91DABD}" />
                <VerticalStackLayout x:Name="MarketplacePageErrorPanel" IsVisible="False" Margin="22,0" Spacing="8">
                    <Label x:Name="MarketplacePageError" FontSize="11" HorizontalTextAlignment="Center" TextColor="#B34838" />
                    <Button AutomationId="RetryMarketplaceButton" Text="Retry" Clicked="OnRetryMarketplaceClicked"
                            HeightRequest="40" Padding="18,0" CornerRadius="12" HorizontalOptions="Center"
                            BackgroundColor="Transparent" BorderColor="#B34838" BorderWidth="1" TextColor="#B34838" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="LoadingServices" IsVisible="False" Margin="22,0" Spacing="14"
                                     SemanticProperties.Description="Loading services">
                    <controls:SkeletonCard Kind="Service" />
                    <controls:SkeletonCard Kind="Service" />
                </VerticalStackLayout>
                <Border x:Name="EmptyServices" IsVisible="False" Margin="22,0" Padding="28,34" Stroke="#E3E7E4"
                        StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light=#FBFCFB, Dark=#1C2520}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="◇" FontSize="38" TextColor="#0F6B4F" HorizontalTextAlignment="Center" />
                        <Label x:Name="EmptyServicesTitle" Text="No services found" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="EmptyServicesDescription" Text="Try another school, category, or search." FontSize="11" TextColor="#66716B" HorizontalTextAlignment="Center" />
                        <Button Text="Clear filters" Clicked="OnClearFiltersClicked" Margin="0,8,0,0"
                                BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#1D4537}"
                                TextColor="{AppThemeBinding Light=#08543D, Dark=#91DABD}"
                                CornerRadius="12" HeightRequest="42" Padding="18,0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
