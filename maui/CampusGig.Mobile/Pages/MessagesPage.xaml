<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CampusGig.Mobile.Models"
             xmlns:controls="clr-namespace:CampusGig.Mobile.Controls"
             x:Class="CampusGig.Mobile.Pages.MessagesPage"
             BackgroundColor="{AppThemeBinding Light=#F3F5F3, Dark=#111713}">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Style="{StaticResource MainTabHeaderStyle}">
            <Grid IsClippedToBounds="True">
                <Ellipse Style="{StaticResource MainTabHeaderAccentStyle}" />
                <VerticalStackLayout Spacing="1" VerticalOptions="Center" ZIndex="1">
                    <Label x:Name="MessagesTitle" AutomationId="MessagesTitle" Text="Messages" Style="{StaticResource PageTitleStyle}" />
                    <Label Text="Keep project conversations in one place." Style="{StaticResource MainTabHeaderSubtitleStyle}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20,0" ColumnDefinitions="*,40,40" ColumnSpacing="8">
        <Border Grid.Column="0" HeightRequest="44" Padding="12,0" Stroke="#E0E7E2"
                StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#151D19}">
            <Grid ColumnDefinitions="26,*,32">
                <Label Text="⌕" FontSize="20" TextColor="#08543D" VerticalTextAlignment="Center" />
                <Entry x:Name="MessageSearch" Grid.Column="1" Placeholder="Search conversations" TextChanged="OnSearchChanged" FontSize="13" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" PlaceholderColor="#929A96" VerticalOptions="Center" />
                <Button x:Name="ClearSearchButton" Grid.Column="2" Text="×" Clicked="OnClearSearchClicked" IsVisible="False"
                        SemanticProperties.Description="Clear conversation search"
                        FontSize="20" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
            </Grid>
        </Border>
        <ImageButton x:Name="ArchiveInboxButton" Grid.Column="1" Source="message_archive.svg"
                     WidthRequest="40" HeightRequest="40" Padding="9" CornerRadius="20"
                     VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light=#F2EED8, Dark=#39351F}"
                     Clicked="OnArchiveInboxClicked" SemanticProperties.Description="Show archived conversations" />
        <Border x:Name="UnreadCountBadge" Grid.Column="2" WidthRequest="40" HeightRequest="40"
                SemanticProperties.Description="Unread conversation count"
                StrokeThickness="0" BackgroundColor="#DFF2E8" StrokeShape="RoundRectangle 20"
                VerticalOptions="Center">
            <Label x:Name="UnreadCountLabel" Text="0" FontSize="13" FontAttributes="Bold" TextColor="#08543D"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>
        </Grid>
        <RefreshView Grid.Row="2" x:Name="Refresh" Refreshing="OnRefreshing" RefreshColor="#0F6B4F">
            <CollectionView x:Name="ConversationList" SelectionMode="None" Margin="20,0" VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,64,20,20" Spacing="8" HorizontalOptions="Center">
                        <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 32" BackgroundColor="{AppThemeBinding Light=#E2F0E8, Dark=#203B30}" HorizontalOptions="Center">
                            <Label Text="◌" FontSize="34" TextColor="#08543D" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label x:Name="EmptyConversationsTitle" Text="No conversations yet" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label x:Name="EmptyConversationsBody" Text="Your conversations will appear here after a booking is created." FontSize="13" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConversationItem">
                        <SwipeView Margin="0,0,0,9" Threshold="120" HorizontalOptions="Fill">
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                    <SwipeItemView WidthRequest="132">
                                        <Border WidthRequest="132" Padding="0" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 17">
                                        <Grid WidthRequest="132" ColumnDefinitions="44,44,44">
                                            <Grid AutomationId="PinConversationAction" BackgroundColor="#DFF2E8"
                                                  SemanticProperties.Description="Pin conversation">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnPinConversationTapped" />
                                                </Grid.GestureRecognizers>
                                                <Image Source="message_pin.svg" WidthRequest="18" HeightRequest="18"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid Grid.Column="1" AutomationId="ArchiveConversationAction" BackgroundColor="#F2EED8"
                                                  SemanticProperties.Description="Archive conversation">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnArchiveConversationTapped" />
                                                </Grid.GestureRecognizers>
                                                <Image Source="message_archive.svg" WidthRequest="18" HeightRequest="18"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid Grid.Column="2" AutomationId="DeleteConversationAction" BackgroundColor="#C53D32"
                                                  SemanticProperties.Description="Delete conversation">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnDeleteConversationTapped" />
                                                </Grid.GestureRecognizers>
                                                <Image Source="message_delete.svg" WidthRequest="18" HeightRequest="18"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>
                        <Border Padding="12" Stroke="{AppThemeBinding Light=#E0E6E2, Dark=#385046}" StrokeShape="RoundRectangle 15"
                                BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConversationTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="42,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                <Border Grid.RowSpan="3" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 13" BackgroundColor="#DDECE4">
                                    <Grid IsClippedToBounds="True">
                                        <Label Text="{Binding Participant.Initial}" FontAttributes="Bold" TextColor="#0F6B4F"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Image Source="{Binding Participant.AvatarUrl}" Aspect="AspectFill" IsVisible="{Binding Participant.HasAvatar}" />
                                    </Grid>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Participant.DisplayName}" FontSize="12" FontAttributes="Bold" Margin="0,0,20,0"
                                       TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" LineBreakMode="TailTruncation" />
                                <Image Grid.Column="1" Source="message_pin.svg" WidthRequest="14" HeightRequest="14"
                                       HorizontalOptions="End" VerticalOptions="Start" IsVisible="{Binding IsPinned}" />
                                <Label Grid.Column="2" Text="{Binding UpdatedLabel}" FontSize="8" MaxLines="1" LineBreakMode="NoWrap"
                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding HeaderLabel}" FontSize="8" FontAttributes="Bold"
                                       MaxLines="1" LineBreakMode="TailTruncation" TextColor="#0F6B4F" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Preview}" MaxLines="1" FontSize="9"
                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" LineBreakMode="TailTruncation" />
                                <Border Grid.Row="2" Grid.Column="2" IsVisible="{Binding HasUnread}" MinimumWidthRequest="20" HeightRequest="20"
                                        Padding="5,0" StrokeThickness="0" BackgroundColor="#DFF2E8" StrokeShape="RoundRectangle 10">
                                    <Label Text="{Binding UnreadLabel}" FontSize="8" FontAttributes="Bold" TextColor="#08543D"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,4,0,0">
                        <Button x:Name="LoadMoreConversationsButton" AutomationId="LoadMoreConversationsButton"
                                Text="Load more conversations" IsVisible="False" Clicked="OnLoadMoreConversationsClicked"
                                HorizontalOptions="Center" Padding="18,10" CornerRadius="18"
                                BackgroundColor="#E2F0E8" TextColor="#08543D" FontSize="12" />
                        <BoxView HeightRequest="24" BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
        <VerticalStackLayout x:Name="LoadingConversations" Grid.Row="2" IsVisible="False" Margin="18,8,18,0"
                             Spacing="12" VerticalOptions="Start" SemanticProperties.Description="Loading conversations">
            <controls:SkeletonCard Kind="Conversation" />
            <controls:SkeletonCard Kind="Conversation" />
            <controls:SkeletonCard Kind="Conversation" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
