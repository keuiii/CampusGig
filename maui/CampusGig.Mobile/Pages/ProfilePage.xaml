<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CampusGig.Mobile.Controls"
             x:Class="CampusGig.Mobile.Pages.ProfilePage"
             Title="Profile"
             BackgroundColor="{AppThemeBinding Light=#F3F5F3, Dark=#111713}">
    <Grid>
    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing" RefreshColor="#0F6B4F">
        <ScrollView x:Name="ProfileScrollView">
            <VerticalStackLayout x:Name="ProfileContent" Padding="20,16,20,32" Spacing="12"
                                 MaximumWidthRequest="620" HorizontalOptions="Center">
                <!-- Screen Header -->
                <Border Style="{StaticResource MainTabHeaderStyle}" Margin="0">
                    <Grid IsClippedToBounds="True">
                        <Ellipse Style="{StaticResource MainTabHeaderAccentStyle}" />
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center" ZIndex="1">
                            <Label x:Name="PageTitleLabel" AutomationId="ProfileTitle" Text="Profile" Style="{StaticResource PageTitleStyle}" />
                            <Label Text="Manage your account and provider presence." Style="{StaticResource MainTabHeaderSubtitleStyle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Top Profile Card -->
                <Border x:Name="ProfileCard" Padding="18,16" Stroke="{AppThemeBinding Light=#E5ECE7, Dark=#34423A}" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1A231F}"
                        Shadow="0,2,10,#0D000000">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                        <!-- Centered Avatar with + button -->
                        <Grid HorizontalOptions="Center" WidthRequest="68" HeightRequest="68">
                            <Border WidthRequest="68" HeightRequest="68" StrokeThickness="0" StrokeShape="RoundRectangle 34"
                                    BackgroundColor="{AppThemeBinding Light=#DCECE4, Dark=#243F32}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvatarClicked" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Label x:Name="InitialsLabel" Text="D" FontSize="24" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#08543D, Dark=#D9F36A}"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Image x:Name="AvatarImage" Aspect="AspectFill" IsVisible="False" ZIndex="2" />
                                </Grid>
                            </Border>
                            <!-- Plus Badge -->
                            <Border WidthRequest="26" HeightRequest="26" HorizontalOptions="End" VerticalOptions="End"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 13" BackgroundColor="#08543D">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvatarClicked" />
                                </Border.GestureRecognizers>
                                <Label Text="&#xFF0B;" FontSize="14" FontAttributes="Bold" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>

                        <Label Text="Tap to change profile picture" FontSize="11" TextColor="#7E8B84" HorizontalTextAlignment="Center" />
                        <Label x:Name="NameLabel" Text="{Binding DisplayName}" FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" HorizontalTextAlignment="Center" />
                        <Label x:Name="EmailLabel" Text="{Binding Email}" FontSize="13" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" HorizontalTextAlignment="Center" />

                        <!-- Role Pill - shows roles or verification status -->
                        <Border HorizontalOptions="Center" Padding="12,3" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#243F32}" Margin="0,4,0,2">
                            <Label x:Name="RolesLabel" Text="{Binding RolesText}" FontSize="10" CharacterSpacing="1.2"
                                   FontAttributes="Bold" TextColor="{AppThemeBinding Light=#08543D, Dark=#D9F36A}" />
                        </Border>

                        <!-- Role-aware student onboarding or provider readiness progress -->
                        <VerticalStackLayout x:Name="ProgressSection" IsVisible="{Binding ShowsProviderJourney}" Spacing="5" Margin="0,6,0,0">
                            <Border HeightRequest="6" BackgroundColor="{AppThemeBinding Light=#E5ECE7, Dark=#2A3831}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 3" HorizontalOptions="Fill">
                                <BoxView x:Name="ProgressBarFill" WidthRequest="60" HeightRequest="6" HorizontalOptions="Start"
                                         Color="{AppThemeBinding Light=#08543D, Dark=#D9F36A}" CornerRadius="3" />
                            </Border>
                            <Label x:Name="CompletionLabel" Text="20% profile complete" FontSize="11" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>

                        <Border x:Name="ProviderVerifiedBadge" IsVisible="False" AutomationId="ProviderVerifiedBadge"
                                HorizontalOptions="Center" Margin="0,10,0,0" Padding="13,7"
                                Stroke="{AppThemeBinding Light=#9CCFBC, Dark=#397A62}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                BackgroundColor="{AppThemeBinding Light=#E9F6F0, Dark=#1D3A2F}">
                            <HorizontalStackLayout Spacing="7">
                                <Border WidthRequest="20" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#087A5A">
                                    <Label Text="&#x2713;" FontSize="12" FontAttributes="Bold" TextColor="White"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                                    <Label Text="VERIFIED PROVIDER" FontSize="9" CharacterSpacing="1.1" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#08543D, Dark=#8BE0BE}" />
                                    <Label Text="Profile ready for clients" FontSize="10"
                                           TextColor="{AppThemeBinding Light=#52615A, Dark=#B9C8C0}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Client Info Card (shown for client accounts) -->
                <Border x:Name="ClientInfoCard" IsVisible="{Binding IsClientOnly}" Padding="18" Stroke="#E5ECE7" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A231F}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="You're using CampusGig as a client" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                        <Label Text="You can browse services, choose preferred schools, place orders, message providers, and leave reviews. This account does not claim student status, so student verification and provider tools are hidden."
                               FontSize="12" TextColor="#66716B" LineHeight="1.45" />
                    </VerticalStackLayout>
                </Border>
                    <!-- Appearance -->
                    <Border Padding="17,14" Stroke="{AppThemeBinding Light=#E5ECE7, Dark=#34423A}" StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A231F}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#EAF3EE, Dark=#243F32}">
                                <Label Text="&#x25D0;" FontSize="18" TextColor="#08543D" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Night mode" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                <Label Text="Use a darker theme for comfortable viewing" FontSize="11" TextColor="#66716B" />
                            </VerticalStackLayout>
                            <!-- Custom Sun / Moon Switch -->
                            <Border Grid.Column="2" x:Name="ThemeToggle" WidthRequest="64" HeightRequest="34" Padding="2"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 17"
                                    BackgroundColor="{AppThemeBinding Light=#E5EAE7, Dark=#244035}" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeToggled" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Label Text="&#x2600;" FontSize="13" TextColor="#D4A017" HorizontalOptions="Start" Margin="8,0,0,0" VerticalTextAlignment="Center" />
                                    <Label Text="&#x263E;" FontSize="13" TextColor="#66716B" HorizontalOptions="End" Margin="0,0,8,0" VerticalTextAlignment="Center" />
                                    <Border x:Name="ThemeThumb" WidthRequest="28" HeightRequest="28" HorizontalOptions="Start"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#08543D}"
                                            Shadow="0,2,6,#25000000" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Student information -->
                    <VerticalStackLayout x:Name="StudentSection" IsVisible="{Binding IsStudent}" Spacing="14">
                        <Border Padding="0" Stroke="{AppThemeBinding Light=#E5ECE7, Dark=#34423A}" StrokeShape="RoundRectangle 18"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A231F}">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="19,17" ColumnDefinitions="*,Auto" ColumnSpacing="12" AutomationId="CampusIdentityHeader">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStudentIdentityHeaderClicked" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Set up your campus identity" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                        <Label Text="School, program, year level, and bio" FontSize="12" TextColor="#66716B" />
                                    </VerticalStackLayout>
                                    <Label x:Name="StudentIdentityChevron" Grid.Column="1" Text="&#x203A;" FontSize="23" TextColor="#66716B"
                                           VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                                </Grid>

                                <VerticalStackLayout x:Name="StudentIdentityForm" IsVisible="False" Padding="19,2,19,19" Spacing="12" AutomationId="CampusIdentityForm">
                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#2A3731}" Margin="0,0,0,3" />
                                <Label Text="This information connects you to the correct participating school." FontSize="12" TextColor="#66716B" Margin="0,0,0,2" />

                                <Label Text="PARTICIPATING SCHOOL" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,4">
                                    <HorizontalStackLayout x:Name="SchoolChipsContainer" Spacing="8" />
                                </ScrollView>

                                <Label Text="PROGRAM / COURSE" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                    <Entry x:Name="ProgramEntry" Placeholder="e.g. BS Information Technology" FontSize="13" ReturnType="Next"
                                           TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" PlaceholderColor="#929A96" VerticalOptions="Center" />
                                </Border>

                                <Label Text="YEAR LEVEL" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                    <Entry x:Name="YearEntry" Placeholder="e.g. 4" AutomationId="StudentYearLevel"
                                           Keyboard="Numeric" MaxLength="1" FontSize="13" ReturnType="Done"
                                           TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}"
                                           PlaceholderColor="#929A96" VerticalOptions="Center" />
                                </Border>

                                <Label Text="SHORT BIO (OPTIONAL)" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,8" HeightRequest="85"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                    <Editor x:Name="BioEntry" Placeholder="Tell the campus community about yourself" MaxLength="500" FontSize="13"
                                            TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" PlaceholderColor="#929A96" />
                                </Border>

                                <controls:BusyButton x:Name="SaveStudentButton" Text="Save student profile" BusyText="Saving profile" Clicked="OnSaveStudentClicked"
                                        FillColor="#84B0A4" TextColor="White"
                                        CornerRadius="14" WidthRequest="220" HeightRequest="48" Margin="0,6,0,0" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- School verification -->
                        <Border Padding="19" Stroke="{AppThemeBinding Light=#E5ECE7, Dark=#34423A}" StrokeShape="RoundRectangle 18"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A231F}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Verify your student identity" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                <Label Text="Upload a clear student ID. It stays private and is available only to authorized CampusGig administrators."
                                       FontSize="12" TextColor="#66716B" Margin="0,-4,0,2" />

                                <Border x:Name="VerificationStatusBadge" IsVisible="False" Padding="12,8" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#E2F1E8">
                                    <Label x:Name="VerificationStatusLabel" FontSize="12" FontAttributes="Bold" TextColor="#08543D" />
                                </Border>
                                <Label x:Name="VerificationReasonLabel" IsVisible="False" TextColor="#B42318" FontSize="11" />

                                <!-- ID Picker Box -->
                                <Border x:Name="IdPickerBox" Stroke="#CCD9D1" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{AppThemeBinding Light=#FBFDFB, Dark=#151D19}" Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnVerificationClicked" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{AppThemeBinding Light=#E5F2EB, Dark=#243F32}">
                                            <Label Text="&#x25A4;" FontSize="20" TextColor="#08543D" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label x:Name="SelectedIdNameLabel" Text="Choose student ID" FontSize="13" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                            <Label x:Name="SelectedIdSizeLabel" Text="JPG, PNG, or PDF &#xB7; maximum 5 MB" FontSize="11" TextColor="#66716B" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="Browse" FontSize="13" FontAttributes="Bold" TextColor="#08543D" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>

                                <controls:BusyButton x:Name="VerificationButton" Text="Submit for verification" BusyText="Submitting ID" Clicked="OnSubmitVerificationClicked"
                                        FillColor="#84B0A4" TextColor="White"
                                        CornerRadius="14" WidthRequest="220" HeightRequest="48" Margin="0,4,0,0" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Profile actions -->
                    <Border Padding="0" Stroke="{AppThemeBinding Light=#E5ECE7, Dark=#34423A}" StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A231F}">
                        <VerticalStackLayout Spacing="0">
                            <!-- Provider Profile Row -->
                            <Border x:Name="ProviderProfileRow" IsVisible="{Binding ShowsProviderJourney}" Padding="16,14" StrokeThickness="0" BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProviderProfileRowClicked" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light=#EAF3EE, Dark=#243F32}">
                                        <Label Text="&#x2197;" FontSize="20" TextColor="#08543D" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Provider profile" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                        <Label x:Name="ProviderRowSubtitle" Text="{Binding ProviderSubtitle}" FontSize="11" TextColor="#66716B" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" x:Name="ProviderChevron" Text="&#x203A;" FontSize="20" TextColor="#99A49E" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Expandable Provider Panel -->
                            <VerticalStackLayout x:Name="ProviderPanel" IsVisible="False" Padding="18,0,18,18" Spacing="12">
                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" Margin="0,0,0,8" />
                                <Label Text="HEADLINE" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                    <Entry x:Name="HeadlineEntry" Placeholder="e.g. Full-Stack Web &amp; Mobile Developer" MaxLength="100" FontSize="13" ReturnType="Next" />
                                </Border>
                                <Label Text="BIO" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,8" HeightRequest="95">
                                    <Editor x:Name="ProviderBioEntry" Placeholder="Describe your experience and services" MaxLength="1000" FontSize="13" />
                                </Border>
                                <Label Text="SKILLS (COMMA SEPARATED)" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                    <Entry x:Name="SkillsEntry" Placeholder="React, C#, Figma, UI/UX" FontSize="13" ReturnType="Next" />
                                </Border>
                                <Label Text="PUBLIC LINKS (OPTIONAL)" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" Margin="0,4,0,0" />
                                <Label Text="HTTPS links appear on your public profile. Keep bookings and payments in CampusGig."
                                       FontSize="10" LineHeight="1.3" TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                    <Entry x:Name="InstagramEntry" AutomationId="ProviderInstagramUrl" Placeholder="Instagram URL" Keyboard="Url" MaxLength="300" FontSize="13" ReturnType="Next" />
                                </Border>
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                    <Entry x:Name="LinkedinEntry" AutomationId="ProviderLinkedinUrl" Placeholder="LinkedIn URL" Keyboard="Url" MaxLength="300" FontSize="13" ReturnType="Next" />
                                </Border>
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                    <Entry x:Name="XEntry" AutomationId="ProviderXUrl" Placeholder="X URL" Keyboard="Url" MaxLength="300" FontSize="13" ReturnType="Next" />
                                </Border>
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                    <Entry x:Name="PortfolioEntry" AutomationId="ProviderPortfolioUrl" Placeholder="Portfolio URL" Keyboard="Url" MaxLength="300" FontSize="13" ReturnType="Done" />
                                </Border>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="Available for new work" FontSize="14" FontAttributes="Bold" />
                                        <Label x:Name="AvailabilityStatusLabel" Text="Online · clients can send requests" FontSize="10" TextColor="#0F8060" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" x:Name="AvailableSwitch" OnColor="#0F6B4F" />
                                </Grid>
                                <Label Text="WORKLOAD LIMITS" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" Margin="0,4,0,0" />
                                <Label Text="Limits are checked safely when clients send requests and when you accept work."
                                       FontSize="10" LineHeight="1.3" TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="Active orders" FontSize="11" FontAttributes="Bold" />
                                        <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="48">
                                            <Entry x:Name="MaxActiveOrdersEntry" AutomationId="MaxActiveOrders" Text="5" Keyboard="Numeric" MaxLength="2" FontSize="13" ReturnType="Next" />
                                        </Border>
                                        <Label Text="1 to 20" FontSize="9" TextColor="#66716B" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="Pending requests" FontSize="11" FontAttributes="Bold" />
                                        <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="48">
                                            <Entry x:Name="MaxPendingOrdersEntry" AutomationId="MaxPendingOrders" Text="50" Keyboard="Numeric" MaxLength="3" FontSize="13" ReturnType="Done" />
                                        </Border>
                                        <Label Text="1 to 100" FontSize="9" TextColor="#66716B" />
                                    </VerticalStackLayout>
                                </Grid>
                                <controls:BusyButton x:Name="SaveProviderButton" Text="Save provider profile" BusyText="Saving provider profile" Clicked="OnSaveProviderClicked"
                                        FillColor="#0F6B4F" TextColor="White" CornerRadius="14" WidthRequest="220" HeightRequest="48" Margin="0,4,0,0" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <BoxView x:Name="ProviderListingsDivider" IsVisible="{Binding IsProvider}" HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" />
                            <Border x:Name="ProviderListingsRow" IsVisible="{Binding IsProvider}" AutomationId="ProviderListingsRow"
                                    Padding="16,14" StrokeThickness="0" BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProviderListingsClicked" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light=#EAF3EE, Dark=#243F32}">
                                        <Label Text="&#x25A4;" FontSize="19" TextColor="#08543D"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="My listings" FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                        <Label Text="Preview, pause, resume or archive services" FontSize="11" TextColor="#66716B" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="&#x203A;" FontSize="20" TextColor="#99A49E" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>

                            <BoxView x:Name="ProviderEarningsDivider" IsVisible="{Binding IsProvider}" HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" />
                            <Border x:Name="ProviderEarningsRow" IsVisible="{Binding IsProvider}" AutomationId="ProviderEarningsRow"
                                    Padding="16,14" StrokeThickness="0" BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProviderEarningsClicked" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light=#EAF3EE, Dark=#243F32}">
                                        <Label Text="&#x20B1;" FontSize="18" TextColor="#08543D"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Provider Earnings" FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                        <Label Text="Read-only paid-order earnings history" FontSize="11" TextColor="#66716B" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="&#x203A;" FontSize="20" TextColor="#99A49E" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>

                            <BoxView x:Name="ProviderProfileDivider" IsVisible="{Binding ShowsProviderJourney}" HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" />

                            <!-- Account Settings Row -->
                            <Border Padding="16,14" StrokeThickness="0" BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAccountSettingsRowClicked" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light=#EAF3EE, Dark=#243F32}">
                                        <Label Text="&#x2699;" FontSize="20" TextColor="#08543D" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Account settings" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                        <Label Text="Roles and password security" FontSize="11" TextColor="#66716B" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" x:Name="SettingsChevron" Text="&#x203A;" FontSize="20" TextColor="#99A49E" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Expandable Account Settings Panel -->
                            <VerticalStackLayout x:Name="SettingsPanel" IsVisible="False" Padding="18,0,18,18" Spacing="12">
                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" Margin="0,0,0,8" />
                                <VerticalStackLayout x:Name="PasswordForm" Spacing="12">
                                <Label Text="Change password" FontSize="16" FontAttributes="Bold" />
                                <Border Stroke="{AppThemeBinding Light=#DDE4DF, Dark=#385046}" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Entry x:Name="CurrentPasswordEntry" Placeholder="Current password" IsPassword="True" FontSize="13" ReturnType="Next" />
                                        <Button Grid.Column="1" Text="Show" Clicked="OnPasswordVisibilityClicked" CommandParameter="current"
                                                BackgroundColor="Transparent" TextColor="#0F6B4F" FontSize="10" FontAttributes="Bold" Padding="9,0" />
                                    </Grid>
                                </Border>
                                <Border Stroke="{AppThemeBinding Light=#DDE4DF, Dark=#385046}" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Entry x:Name="NewPasswordEntry" Placeholder="New password (at least 8 chars)" IsPassword="True" FontSize="13" ReturnType="Next" />
                                        <Button Grid.Column="1" Text="Show" Clicked="OnPasswordVisibilityClicked" CommandParameter="new"
                                                BackgroundColor="Transparent" TextColor="#0F6B4F" FontSize="10" FontAttributes="Bold" Padding="9,0" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout x:Name="NewPasswordStrengthPanel" IsVisible="False" Margin="0,-4,0,0" Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Text="PASSWORD STRENGTH" FontSize="8" CharacterSpacing="1.1" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                        <Label x:Name="NewPasswordStrengthLabel" Grid.Column="1" FontSize="9" FontAttributes="Bold" />
                                    </Grid>
                                    <ProgressBar x:Name="NewPasswordStrengthBar" Progress="0" HeightRequest="5"
                                                 BackgroundColor="{AppThemeBinding Light=#E3E9E5, Dark=#2C3933}" />
                                </VerticalStackLayout>
                                <Border Stroke="{AppThemeBinding Light=#DDE4DF, Dark=#385046}" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirm new password" IsPassword="True" FontSize="13" ReturnType="Next" />
                                        <Button Grid.Column="1" Text="Show" Clicked="OnPasswordVisibilityClicked" CommandParameter="confirm"
                                                BackgroundColor="Transparent" TextColor="#0F6B4F" FontSize="10" FontAttributes="Bold" Padding="9,0" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout x:Name="PasswordMfaPanel" IsVisible="False" Spacing="8">
                                    <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                        <Entry x:Name="PasswordMfaEntry" Placeholder="Authenticator or recovery code" FontSize="13" ReturnType="Done" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Use recovery code" FontSize="13" VerticalTextAlignment="Center" />
                                        <Switch Grid.Column="1" x:Name="RecoveryCodeSwitch" />
                                    </Grid>
                                </VerticalStackLayout>
                                <controls:BusyButton x:Name="UpdatePasswordButton" Text="Update password" BusyText="Updating password" Clicked="OnChangePasswordClicked"
                                        FillColor="#0F6B4F" TextColor="White" CornerRadius="14" WidthRequest="210" HeightRequest="46" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <Border x:Name="PasswordPendingPanel" IsVisible="False" Padding="16" Stroke="{AppThemeBinding Light=#CFE0D7, Dark=#385046}"
                                        BackgroundColor="{AppThemeBinding Light=#F4FAF7, Dark=#151D19}" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout Spacing="10">
                                        <Border WidthRequest="44" HeightRequest="44" Padding="0" HorizontalOptions="Start" StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#1E493A}" StrokeShape="RoundRectangle 22">
                                            <Label Text="&#x2709;" FontSize="21" TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#71D7B1}"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <Label Text="Waiting for email confirmation" FontSize="16" FontAttributes="Bold" />
                                        <Label x:Name="PasswordPendingBody" FontSize="12" LineHeight="1.35" TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="12"
                                              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A231F}">
                                            <ActivityIndicator IsRunning="True" WidthRequest="20" HeightRequest="20" Color="#0F8060" />
                                            <Label Grid.Column="1" Text="Checking for your decision..." FontSize="12" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                        </Grid>
                                        <Label x:Name="PasswordPendingExpiry" FontSize="11" TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                        <controls:BusyButton x:Name="CancelPasswordChangeButton" Text="Cancel password change" BusyText="Cancelling request"
                                                Clicked="OnCancelPasswordChangeClicked" FillColor="#FFF0ED" TextColor="#B42318"
                                                CornerRadius="12" HeightRequest="44" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Border>

                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" Margin="0,8" />
                                <!-- Two-Factor Authentication -->
                                <Border Padding="16" Stroke="{AppThemeBinding Light=#DCE9E2, Dark=#315044}"
                                        BackgroundColor="{AppThemeBinding Light=#F7FBF9, Dark=#14231D}" StrokeShape="RoundRectangle 18">
                                    <VerticalStackLayout Spacing="14">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#DDF2E8, Dark=#1C4A3A}" StrokeShape="RoundRectangle 14">
                                                <Path Data="M 7,10 L 7,7 C 7,4 9,2 12,2 C 15,2 17,4 17,7 L 17,10 M 5,10 L 19,10 L 19,21 L 5,21 Z M 12,14 L 12,17"
                                                      WidthRequest="22" HeightRequest="24" Aspect="Uniform"
                                                      Stroke="{AppThemeBinding Light=#0F6B4F, Dark=#91DABD}"
                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                      Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center"
                                                      SemanticProperties.Description="Two-factor authentication security" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="Two-factor authentication" FontSize="15" FontAttributes="Bold" />
                                                <Label Text="Extra protection for your account" FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                            </VerticalStackLayout>
                                            <Border x:Name="MfaBadgeContainer" Grid.Column="2" Padding="10,5" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#E8EEEB, Dark=#28352F}" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                <Label x:Name="MfaBadge" Text="OFF" FontSize="10" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#B8C5BF}" />
                                            </Border>
                                        </Grid>

                                        <Label x:Name="MfaDetailsLabel" FontSize="11" LineHeight="1.3"
                                               TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />

                                        <VerticalStackLayout x:Name="MfaSetupPanel" IsVisible="False" Spacing="12">
                                            <Border Padding="12" BackgroundColor="White" Stroke="#DDE4DF" StrokeShape="RoundRectangle 16" HorizontalOptions="Center">
                                                <Image x:Name="MfaQrImage" WidthRequest="164" HeightRequest="164" />
                                            </Border>
                                            <Label Text="Scan this code, then enter the 6-digit code from your authenticator app."
                                                   FontSize="11" HorizontalTextAlignment="Center" LineHeight="1.3"
                                                   TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                            <Border Padding="12,9" Stroke="{AppThemeBinding Light=#DDE4DF, Dark=#385046}"
                                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#192B23}" StrokeShape="RoundRectangle 12">
                                                <Label x:Name="MfaSecretLabel" FontFamily="monospace" FontAttributes="Bold" HorizontalTextAlignment="Center" FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#154E3D, Dark=#9CE4C7}" />
                                            </Border>
                                            <Border Stroke="{AppThemeBinding Light=#DDE4DF, Dark=#385046}" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48"
                                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                                                <Entry x:Name="MfaSetupCodeEntry" Placeholder="Enter 6-digit code" Keyboard="Numeric" MaxLength="6" FontSize="13" HorizontalTextAlignment="Center" ReturnType="Done" />
                                            </Border>
                                            <controls:BusyButton x:Name="ConfirmMfaButton" Text="Verify and enable" BusyText="Verifying code" Clicked="OnConfirmMfaClicked"
                                                    FillColor="#0F8060" TextColor="White" CornerRadius="12" HeightRequest="46" />
                                        </VerticalStackLayout>

                                        <Border x:Name="RecoveryCodesPanel" IsVisible="False" Padding="14"
                                                BackgroundColor="{AppThemeBinding Light=#FFFBEA, Dark=#302B18}"
                                                Stroke="{AppThemeBinding Light=#E8D78A, Dark=#6D6129}" StrokeShape="RoundRectangle 14">
                                            <VerticalStackLayout Spacing="7">
                                                <Label Text="Save your recovery codes" FontAttributes="Bold" FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#66540A, Dark=#F4DE7B}" />
                                                <Label Text="Store these somewhere safe. Each code can only be used once." FontSize="10" LineHeight="1.3"
                                                       TextColor="{AppThemeBinding Light=#74662C, Dark=#D6C875}" />
                                                <Label x:Name="RecoveryCodesLabel" FontFamily="monospace" FontSize="12" LineHeight="1.4"
                                                       TextColor="{AppThemeBinding Light=#392F08, Dark=#FFF1A8}" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <controls:BusyButton x:Name="SetupMfaButton" Text="Set up authenticator" BusyText="Preparing authenticator" Clicked="OnSetupMfaClicked"
                                                FillColor="#0F8060" TextColor="White" CornerRadius="12" HeightRequest="46" HorizontalOptions="Fill" />

                                        <VerticalStackLayout x:Name="EnabledMfaActions" IsVisible="False" Spacing="12">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Button Text="&#x21BB;  New codes" Clicked="OnRegenerateCodesClicked"
                                                        BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#1D4537}"
                                                        TextColor="{AppThemeBinding Light=#08543D, Dark=#91DABD}" CornerRadius="12" HeightRequest="44" FontSize="11" />
                                                <Button Grid.Column="1" Text="&#x2715;  Revoke devices" Clicked="OnRevokeDevicesClicked"
                                                        BackgroundColor="{AppThemeBinding Light=#E2F1E8, Dark=#1D4537}"
                                                        TextColor="{AppThemeBinding Light=#08543D, Dark=#91DABD}" CornerRadius="12" HeightRequest="44" FontSize="11" />
                                            </Grid>
                                            <Button Text="Disable two-factor authentication" Clicked="OnDisableMfaClicked"
                                                    BackgroundColor="{AppThemeBinding Light=#FFF0ED, Dark=#3D201D}"
                                                    TextColor="{AppThemeBinding Light=#B42318, Dark=#FF9D91}" BorderWidth="1"
                                                    BorderColor="{AppThemeBinding Light=#F2CBC5, Dark=#70413B}" CornerRadius="12"
                                                    HeightRequest="42" FontSize="11" HorizontalOptions="Center" Padding="18,0" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" Margin="0,8" />
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Active sessions" FontSize="14" FontAttributes="Bold" />
                                            <Label Text="Devices currently signed in to CampusGig" FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Sign out all" Clicked="OnSignOutAllClicked"
                                                BackgroundColor="{AppThemeBinding Light=#FFF0ED, Dark=#3D201D}"
                                                TextColor="{AppThemeBinding Light=#B42318, Dark=#FF9D91}"
                                                CornerRadius="12" HeightRequest="38" Padding="14,0" FontSize="11" />
                                    </Grid>
                                    <Label x:Name="AuthSessionsStatusLabel" AutomationId="AuthSessionsStatus"
                                           Text="Loading active sessions..." FontSize="11" IsVisible="False"
                                           TextColor="{AppThemeBinding Light=#66716B, Dark=#A8B6AF}" />
                                    <VerticalStackLayout x:Name="AuthSessionsStack" AutomationId="AuthSessionsList" Spacing="8" />
                                </VerticalStackLayout>

                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" Margin="0,8" />
                                <Label Text="Development API" FontSize="14" FontAttributes="Bold" />
                                <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="46">
                                    <Entry x:Name="ApiUrlEntry" Keyboard="Url" FontSize="12" ReturnType="Done" />
                                </Border>
                                <Button Text="Save API address" Clicked="OnSaveApiClicked" BackgroundColor="#E2F1E8" TextColor="#08543D"
                                        CornerRadius="12" WidthRequest="180" HeightRequest="42" HorizontalOptions="Center" FontSize="12" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                <Border Padding="0" Stroke="{AppThemeBinding Light=#E5ECE7, Dark=#34423A}" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A231F}">
                    <VerticalStackLayout Spacing="0">
                        <Border Padding="16,14" StrokeThickness="0" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSupportHeaderClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#EAF3EE, Dark=#243F32}">
                                    <Path WidthRequest="21" HeightRequest="21" Aspect="Uniform" Stroke="#08543D" StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeLineJoin="Round"
                                          Data="M12,3 C7.029,3 3,6.582 3,11 C3,13.353 4.144,15.47 5.97,16.934 L5,21 L9.55,18.94 C10.33,19.14 11.15,19.25 12,19.25 C16.971,19.25 21,15.668 21,11 C21,6.582 16.971,3 12,3 Z M9,10 C9,8.4 10.2,7.4 12,7.4 C13.8,7.4 15,8.4 15,10 C15,11.3 14.2,11.8 13.2,12.4 C12.4,12.9 12,13.3 12,14 M12,16.5 L12,16.6" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Report a problem" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111814, Dark=#F2F6F3}" />
                                    <Label Text="Contact CampusGig support" FontSize="11" TextColor="#66716B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" x:Name="SupportChevron" Text="&#x203A;" FontSize="20" TextColor="#99A49E" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout x:Name="SupportPanel" IsVisible="False" Padding="18,0,18,18" Spacing="11">
                            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#EEF2EF, Dark=#26332D}" Margin="0,0,0,8" />
                            <Label Text="CATEGORY" FontSize="9" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                            <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                <Picker x:Name="SupportCategoryPicker" AutomationId="SupportCategory" Title="Choose a category" FontSize="13" />
                            </Border>
                            <Label Text="SUBJECT" FontSize="9" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                            <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                                <Entry x:Name="SupportSubjectEntry" AutomationId="SupportSubject" Placeholder="Briefly describe the problem" MaxLength="120" FontSize="13" ReturnType="Next" />
                            </Border>
                            <Label Text="WHAT HAPPENED?" FontSize="9" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#66716B" />
                            <Border Stroke="#DDE4DF" StrokeShape="RoundRectangle 12" Padding="13,8" HeightRequest="120">
                                <Editor x:Name="SupportMessageEntry" AutomationId="SupportMessage" Placeholder="Include what you expected, what happened, and any order number." MaxLength="2000" FontSize="13" />
                            </Border>
                            <Label x:Name="SupportMessageCountLabel" Text="0/2000" FontSize="9" HorizontalTextAlignment="End" TextColor="#66716B" />
                            <controls:BusyButton x:Name="SubmitSupportButton" AutomationId="SubmitSupportTicket" Text="Submit report" BusyText="Submitting report"
                                    Clicked="OnSubmitSupportClicked" FillColor="#0F6B4F" TextColor="White" CornerRadius="13"
                                    WidthRequest="170" HeightRequest="46" HorizontalOptions="Start" />
                            <Label x:Name="SupportReceiptLabel" AutomationId="SupportReceipt" IsVisible="False" FontSize="11" FontAttributes="Bold" TextColor="#0F6B4F" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Sign Out Button -->
                <Button x:Name="SignOutButton" AutomationId="ProfileSignOut" Text="Sign out" WidthRequest="140" HeightRequest="44"
                        BorderWidth="1" BorderColor="#E5ECE7" CornerRadius="22"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A231F}"
                        TextColor="#C53B27" FontSize="14" FontAttributes="Bold"
                        HorizontalOptions="Center" Margin="0,14,0,24" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
        <ScrollView x:Name="ProfileSkeleton" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#F3F5F3, Dark=#111713}"
                    SemanticProperties.Description="Loading profile">
            <VerticalStackLayout Padding="20,18,20,48" Spacing="16" MaximumWidthRequest="620" HorizontalOptions="Center">
                <controls:SkeletonBlock WidthRequest="150" HeightRequest="28" StrokeShape="RoundRectangle 8" />
                <controls:SkeletonCard Kind="Profile" />
                <controls:SkeletonCard Kind="Listing" />
                <controls:SkeletonCard Kind="Listing" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
