<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CampusGig.Mobile.Models" xmlns:controls="clr-namespace:CampusGig.Mobile.Controls"
             x:Class="CampusGig.Mobile.Pages.OrderWorkspacePage" Title="Order workspace"
             BackgroundColor="{AppThemeBinding Light=#F3F5F3, Dark=#111713}">
    <RefreshView x:Name="Refresh" AutomationId="OrderWorkspace" Refreshing="OnRefreshing" RefreshColor="#0F6B4F">
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout x:Name="WorkspaceContent" Padding="20,14,20,30" Spacing="12">
                <Border Padding="16,10" Stroke="{AppThemeBinding Light=#D9E5DF, Dark=#34423A}" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" IsClippedToBounds="True">
                        <Ellipse Grid.RowSpan="4" Grid.ColumnSpan="2" Style="{StaticResource MainTabHeaderAccentStyle}" />
                        <Button Text="&lt; Orders" Clicked="OnCloseClicked" BackgroundColor="Transparent" TextColor="#0F6B4F"
                                Padding="0" HeightRequest="36" FontAttributes="Bold" FontSize="13" HorizontalOptions="Start" />
                        <Border Grid.Column="1" Padding="11,5" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#DDF1E7, Dark=#244035}" StrokeShape="RoundRectangle 13" VerticalOptions="Center">
                            <Label x:Name="StatusLabel" FontSize="9" CharacterSpacing="0.7" FontAttributes="Bold" TextColor="#075B42" />
                        </Border>
                        <Label x:Name="TitleLabel" Grid.Row="1" Grid.ColumnSpan="2" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" LineBreakMode="TailTruncation" />
                        <Border Grid.Row="2" Grid.ColumnSpan="2" HorizontalOptions="Start" Padding="10,5"
                                Stroke="{AppThemeBinding Light=#CFE4D9, Dark=#365346}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=#EFF7F3, Dark=#192A22}">
                            <Label x:Name="OrderMetaLabel" AutomationId="WorkspaceOrderNumber" FontSize="10" CharacterSpacing="0.8"
                                   FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#91DABD}" LineBreakMode="TailTruncation" />
                        </Border>
                        <Label x:Name="StatusGuidanceLabel" Grid.Row="3" Grid.ColumnSpan="2" FontSize="11" LineHeight="1.3" TextColor="{AppThemeBinding Light=#59655F, Dark=#B4C1BA}" />
                    </Grid>
                </Border>

                <Border Padding="14,12" Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light=#EFF7F3, Dark=#192A22}">
                    <Grid ColumnDefinitions="48,*" ColumnSpacing="13">
                        <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24"
                                BackgroundColor="{AppThemeBinding Light=#DCEFE5, Dark=#244035}">
                            <Grid>
                                <Label x:Name="RoleIconLabel" Text="C" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#71D7B1}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                <Image x:Name="CounterpartyAvatarImage" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label x:Name="WorkspaceRoleLabel" Text="ORDER CONTACT" FontSize="8" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#0F6B4F" />
                            <Label x:Name="CounterpartyLabel" AutomationId="WorkspaceCounterparty" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                            <Label x:Name="CounterpartyDetailLabel" FontSize="10" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="16" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="PROJECT BRIEF" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                            <Label Text="Project requirements" FontSize="19" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        </VerticalStackLayout>
                        <Label x:Name="RequirementsLabel" FontSize="13" LineHeight="1.35" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#3E4A44, Dark=#D1DDD7}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E7ECE9, Dark=#2B3A32}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4"><Label x:Name="PackageHeadingLabel" Text="PACKAGE" FontSize="8" CharacterSpacing="1" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}"/><Label x:Name="PackageLabel" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}"/></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="TOTAL" FontSize="8" CharacterSpacing="1" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}"/><Label x:Name="TotalLabel" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}"/></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4"><Label x:Name="DeliveryDateHeadingLabel" Text="DUE" FontSize="8" CharacterSpacing="1" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}"/><Label x:Name="DueLabel" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}"/></VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="PaymentPanel" IsVisible="False" Padding="16"
                        BackgroundColor="{AppThemeBinding Light=#F3FAF6, Dark=#192A22}"
                        Stroke="{AppThemeBinding Light=#CFE4D9, Dark=#365346}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="SECURE PAYMENT" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                                <Label Text="Pay securely with PayMongo" FontSize="18" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Padding="10,5" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#DCEFE5, Dark=#244035}" VerticalOptions="Center">
                                <Label x:Name="PaymentStatusLabel" FontSize="8" CharacterSpacing="0.6" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#71D7B1}" />
                            </Border>
                        </Grid>
                        <Label x:Name="PaymentGuidanceLabel" FontSize="11" LineHeight="1.3"
                               TextColor="{AppThemeBinding Light=#59655F, Dark=#B4C1BA}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="ORDER TOTAL" FontSize="8" CharacterSpacing="1" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}" />
                                <Label x:Name="PaymentBreakdownLabel" FontSize="10"
                                       TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                            </VerticalStackLayout>
                            <Label x:Name="PaymentTotalLabel" Grid.Column="1" FontSize="20" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" VerticalTextAlignment="Center" />
                        </Grid>
                        <controls:BusyButton x:Name="PaymentCheckoutButton" Text="Proceed to payment" BusyText="Opening secure checkout"
                                             Clicked="OnPaymentCheckoutClicked" FillColor="#0F6B4F" TextColor="White"
                                             WidthRequest="220" HeightRequest="50" CornerRadius="14" HorizontalOptions="Center" />
                        <controls:BusyButton x:Name="PaymentCheckButton" Text="Check payment status" BusyText="Checking payment"
                                             Clicked="OnCheckPaymentClicked" IsVisible="False"
                                             FillColor="{AppThemeBinding Light=#E1F2E9, Dark=#244035}"
                                             TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#91DABD}"
                                             WidthRequest="205" HeightRequest="46" CornerRadius="14" HorizontalOptions="Center" />
                        <Label x:Name="RefundGuidanceLabel" IsVisible="False" FontSize="10" LineHeight="1.3"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#8A4B12, Dark=#F0B36E}" />
                        <controls:BusyButton x:Name="RefundRequestButton" Text="Request full refund" BusyText="Requesting full refund"
                                             Clicked="OnRefundRequestClicked" IsVisible="False"
                                             FillColor="{AppThemeBinding Light=#F7E6D3, Dark=#4A3020}"
                                             TextColor="{AppThemeBinding Light=#8A4B12, Dark=#F0B36E}"
                                             WidthRequest="235" HeightRequest="46" CornerRadius="14" HorizontalOptions="Center" />
                        <Label Text="Payment is confirmed automatically after PayMongo notifies CampusGig."
                               FontSize="9" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="9">
                    <Label Text="DELIVERABLES" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                    <Label x:Name="DeliveryPolicyLabel" IsVisible="False"
                           Text="Downloading a file does not automatically accept the order."
                           FontSize="10" LineHeight="1.3"
                           TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                    <Border x:Name="EmptyFilesLabel" Padding="18" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                            Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                            <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light=#E7F1EC, Dark=#244035}">
                                <Label Text="↓" FontSize="18" TextColor="#0F6B4F" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="EmptyFilesTitleLabel" Text="Waiting for delivery" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                                <Label x:Name="EmptyFilesBodyLabel" Text="No files have been submitted yet." FontSize="10" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <VerticalStackLayout x:Name="DeliverySubmissionList" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DeliverySubmissionItem">
                                <Border Padding="15" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 16">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Stroke" Value="#0F6B4F" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding VersionLabel}" FontSize="10" CharacterSpacing="0.6" FontAttributes="Bold" TextColor="#0F6B4F" />
                                            <Label Grid.Column="1" Text="{Binding SubmittedLabel}" FontSize="9"
                                                   TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}" />
                                        </Grid>
                                        <Label Text="{Binding NoteLabel}" FontSize="11" LineHeight="1.3"
                                               TextColor="{AppThemeBinding Light=#3E4A44, Dark=#D1DDD7}" />
                                        <VerticalStackLayout Spacing="7" BindableLayout.ItemsSource="{Binding Files}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:OrderFileItem">
                                                    <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#F4F8F6, Dark=#17221C}"
                                                            Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 13">
                                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFileTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                                        <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="10">
                                                            <Label Text="⇩" FontSize="17" TextColor="#0F6B4F" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                                <Label Text="{Binding OriginalName}" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" LineBreakMode="TailTruncation" />
                                                                <Label Text="{Binding SizeLabel}" FontSize="9" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                                            </VerticalStackLayout>
                                                            <Label Grid.Column="2" Text="Download" FontSize="10" FontAttributes="Bold" TextColor="#0F6B4F" VerticalTextAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="LegacyFileList" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:OrderFileItem">
                                <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 15">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFileTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="11">
                                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=#E7F1EC, Dark=#244035}">
                                            <Label Text="⇩" FontSize="18" TextColor="#0F6B4F" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding OriginalName}" FontAttributes="Bold" FontSize="12" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding SizeLabel}" FontSize="9" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="Download" FontSize="11" FontAttributes="Bold" TextColor="#0F6B4F" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border x:Name="ProviderDecisionPanel" IsVisible="False" Padding="18" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="NEW SERVICE REQUEST" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label Text="Review this project" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label Text="Accept the request to reserve the project, or provide a short reason when declining." FontSize="11" LineHeight="1.3" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Border Padding="12,5" Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#385046}"
                                BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#151D19}"
                                StrokeShape="RoundRectangle 13">
                            <Editor x:Name="RejectReasonEntry" Placeholder="Reason for declining (at least 3 characters)"
                                    TextChanged="OnRejectReasonChanged" MaxLength="500" HeightRequest="76"
                                    BackgroundColor="Transparent" />
                        </Border>
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="18" HorizontalOptions="Center">
                            <controls:BusyButton Grid.Column="0" Text="×" BusyText="Declining request"
                                                 x:Name="RejectRequestButton" Clicked="OnRejectClicked"
                                                 SemanticDescription="Decline request"
                                                 IsEnabled="False"
                                                 FillColor="{AppThemeBinding Light=#FFF0ED, Dark=#43231F}"
                                                 TextColor="{AppThemeBinding Light=#B42318, Dark=#FF9D91}"
                                                 WidthRequest="54" HeightRequest="54" CornerRadius="27" />
                            <controls:BusyButton Grid.Column="1" Text="✓" BusyText="Accepting request"
                                                 SemanticDescription="Accept request"
                                                 Clicked="OnAcceptClicked" FillColor="#0F6B4F" TextColor="White"
                                                 WidthRequest="54" HeightRequest="54" CornerRadius="27" />
                        </Grid>
                        <Label Text="Decline   •   Accept" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.5"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#7A8580, Dark=#91A099}" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ClientCancelPanel" IsVisible="False" Padding="18"
                        BackgroundColor="{AppThemeBinding Light=#FFF9F7, Dark=#291C1A}"
                        Stroke="{AppThemeBinding Light=#F0D8D2, Dark=#604039}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="PENDING REQUEST" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#A33A2D, Dark=#FF9D91}" />
                        <Label Text="Need to cancel?" FontSize="17" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label Text="You can cancel while the provider has not accepted the request."
                               FontSize="10" LineHeight="1.3" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Border Padding="11,4" Stroke="{AppThemeBinding Light=#E3C9C3, Dark=#66433D}" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}">
                            <Editor x:Name="CancelReasonEntry" Placeholder="Reason for cancelling (at least 3 characters)"
                                    MaxLength="500" HeightRequest="74" BackgroundColor="Transparent" />
                        </Border>
                        <controls:BusyButton Text="Cancel request" BusyText="Cancelling request" Clicked="OnCancelClicked"
                                             FillColor="#FFF0ED" TextColor="#B42318" WidthRequest="190" HeightRequest="46"
                                             CornerRadius="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ProviderStartPanel" IsVisible="False" Padding="18" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="READY TO BEGIN" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label Text="The client has been notified that you accepted this project." FontSize="11" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <controls:BusyButton Text="Start working" BusyText="Starting order" Clicked="OnStartClicked"
                                             FillColor="#0F6B4F" TextColor="White" WidthRequest="190" HeightRequest="50"
                                             CornerRadius="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ProviderDeliveryPanel" IsVisible="False" Padding="18" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="11">
                        <Label Text="DELIVERY" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label x:Name="DeliveryTitleLabel" Text="Submit deliverables" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label Text="Attach 1–5 JPG, PNG, WebP, PDF, ZIP, DOCX, or XLSX files. Maximum 15 MB each." FontSize="10" LineHeight="1.3" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Button Text="Choose deliverable files" Clicked="OnChooseDeliveryFilesClicked" HeightRequest="46" CornerRadius="12"
                                BackgroundColor="{AppThemeBinding Light=#E7F1EC, Dark=#244035}" TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#71D7B1}" FontAttributes="Bold" />
                        <Label x:Name="DeliveryFilesLabel" Text="No files selected" FontSize="10" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Editor x:Name="DeliveryNoteEntry" Placeholder="Add a delivery note (at least 3 characters)" MaxLength="1000" HeightRequest="96"
                                TextChanged="OnDeliveryNoteChanged" BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#151D19}" />
                        <controls:BusyButton x:Name="DeliveryButton" Text="Submit delivery" BusyText="Uploading delivery" Clicked="OnDeliverClicked"
                                IsEnabled="False" FillColor="#0F6B4F" TextColor="White" WidthRequest="190" HeightRequest="50"
                                CornerRadius="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="DeliveryReviewPanel" AutomationId="DeliveryReviewPanel" IsVisible="False" Padding="18"
                        BackgroundColor="{AppThemeBinding Light=#FFF9ED, Dark=#292218}"
                        Stroke="{AppThemeBinding Light=#E8C783, Dark=#69512A}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="DeliveryReviewKickerLabel" Text="48-HOUR DELIVERY REVIEW" FontSize="9" CharacterSpacing="1.4"
                               FontAttributes="Bold" TextColor="#9A6700" />
                        <Label x:Name="DeliveryReviewTitleLabel" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label x:Name="DeliveryReviewBodyLabel" FontSize="10" LineHeight="1.35"
                               TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Label x:Name="DeliveryReviewStateLabel" FontSize="10" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#7A5200, Dark=#FFD27A}" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="SubmittedActions" IsVisible="False" Padding="18" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="REVIEW DELIVERY" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label Text="Check every submitted file, then accept the work or request a specific change." FontSize="15" FontAttributes="Bold"
                               LineHeight="1.2" TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label Text="Accepting completes the order. Otherwise, it completes automatically when the 48-hour review period ends unless a revision or dispute is active."
                               FontSize="10" LineHeight="1.3" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Label x:Name="RevisionsRemainingLabel" FontSize="10" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#526159, Dark=#B7C5BD}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <controls:BusyButton Grid.Column="0" AutomationId="AcceptDeliveryButton" Text="Accept delivery" BusyText="Accepting" Clicked="OnCompleteClicked"
                                                 FillColor="#0F6B4F" TextColor="White" HeightRequest="48" CornerRadius="14"
                                                 HorizontalOptions="Fill" />
                            <Button x:Name="RequestRevisionToggleButton" Grid.Column="1" Text="Request changes" Clicked="OnRevisionComposerClicked"
                                    HeightRequest="48" CornerRadius="14" FontAttributes="Bold"
                                    BackgroundColor="{AppThemeBinding Light=#E7F1EC, Dark=#244035}"
                                    TextColor="{AppThemeBinding Light=#0F6B4F, Dark=#8EDDBE}" />
                        </Grid>
                        <VerticalStackLayout x:Name="RevisionGroup" Spacing="8">
                            <VerticalStackLayout x:Name="RevisionComposer" IsVisible="False" Spacing="8">
                                <Border Padding="12,5" Stroke="{AppThemeBinding Light=#CFE0D7, Dark=#3A5045}"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#151D19}" StrokeShape="RoundRectangle 14">
                                    <Editor x:Name="RevisionEntry" Placeholder="Describe exactly what needs to change" MaxLength="2000" HeightRequest="92"
                                            TextChanged="OnRevisionTextChanged" BackgroundColor="Transparent" />
                                </Border>
                                <Label x:Name="RevisionCounterLabel" Text="0/2000 · minimum 10 characters" FontSize="9"
                                       HorizontalTextAlignment="End" TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}" />
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" HorizontalOptions="End">
                                    <Button Text="Cancel" Clicked="OnRevisionCancelClicked" WidthRequest="92" HeightRequest="44" CornerRadius="13"
                                            BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#C9D8D0, Dark=#3B5146}"
                                            TextColor="{AppThemeBinding Light=#526159, Dark=#C7D4CD}" />
                                    <controls:BusyButton x:Name="RequestRevisionButton" Grid.Column="1" Text="Send request" BusyText="Sending"
                                                         Clicked="OnRevisionClicked" IsEnabled="False" WidthRequest="130" HeightRequest="44" CornerRadius="13"
                                                         FillColor="#0F6B4F" TextColor="White" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Label x:Name="NoRevisionsLeftLabel" Text="All included revisions have been used. An optional paid extra revision may be available." FontSize="11" TextColor="#B54708" IsVisible="False" />
                        <VerticalStackLayout x:Name="ExtraRevisionPanel" IsVisible="False" Spacing="8">
                            <Label Text="OPTIONAL EXTRA REVISION" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                            <Label Text="Purchase Extra Revision" FontSize="16" FontAttributes="Bold" />
                            <Label x:Name="ExtraRevisionPriceLabel" FontSize="11" LineHeight="1.3" />
                            <Label x:Name="ExtraRevisionTurnaroundLabel" FontSize="10" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                            <Editor x:Name="ExtraRevisionEntry" Placeholder="Describe the in-scope extra change" MaxLength="2000" HeightRequest="92" TextChanged="OnExtraRevisionTextChanged" />
                            <controls:BusyButton x:Name="ExtraRevisionCheckoutButton" Text="Purchase Extra Revision" BusyText="Opening checkout" Clicked="OnExtraRevisionCheckoutClicked" IsEnabled="False" FillColor="#0F6B4F" TextColor="White" HeightRequest="46" CornerRadius="13" />
                            <Label x:Name="ExtraRevisionStateLabel" FontSize="10" TextColor="#B54708" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="CorrectionClaimPanel" Spacing="8">
                            <Label Text="Work does not match the original requirements?" FontAttributes="Bold" FontSize="12" />
                            <Label Text="Ask the provider to acknowledge a free correction. This does not bypass revision limits automatically; use the dispute workflow if the provider disagrees." FontSize="10" LineHeight="1.3" />
                            <Editor x:Name="CorrectionEntry" Placeholder="Identify the unmet original requirement" MaxLength="2000" HeightRequest="82" TextChanged="OnCorrectionTextChanged" />
                            <controls:BusyButton x:Name="CorrectionClaimButton" Text="Ask Provider to Acknowledge" BusyText="Sending" Clicked="OnCorrectionClaimClicked" IsEnabled="False" FillColor="#526159" TextColor="White" HeightRequest="44" CornerRadius="13" />
                            <Label x:Name="CorrectionStateLabel" FontSize="10" TextColor="#B54708" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Need something outside the original requirements?" FontAttributes="Bold" FontSize="11" />
                            <Label Text="This request changes the original scope of the order. Create a new order for additional work." FontSize="10" LineHeight="1.3" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ProviderRevisionPanel" IsVisible="False" Padding="18" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="ACTIVE REVISION" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label x:Name="ProviderRevisionTypeLabel" FontSize="16" FontAttributes="Bold" />
                        <Label x:Name="ProviderRevisionInstructionsLabel" FontSize="11" LineHeight="1.3" />
                        <Label x:Name="ProviderRevisionDeadlineLabel" FontSize="10" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Label x:Name="ProviderRevisionEarningLabel" FontSize="10" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Grid x:Name="CorrectionDecisionButtons" IsVisible="False" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="Acknowledge" Clicked="OnCorrectionAcknowledgeClicked" BackgroundColor="#0F6B4F" TextColor="White" />
                            <Button Grid.Column="1" Text="Decline" Clicked="OnCorrectionDeclineClicked" BackgroundColor="#7A5200" TextColor="White" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="DisputePanel" IsVisible="False" Padding="16"
                        BackgroundColor="{AppThemeBinding Light=#F7FAF8, Dark=#1A231F}"
                        Stroke="{AppThemeBinding Light=#D9E5DF, Dark=#34423A}" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="DISPUTE PROTECTION" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label x:Name="DisputeTitleLabel" Text="Report an order problem" FontSize="17" FontAttributes="Bold" />
                        <Label x:Name="DisputeStateLabel" FontSize="11" LineHeight="1.3" />
                        <Label x:Name="DisputeDeadlineLabel" FontSize="10" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label x:Name="DisputeHistoryLabel" FontSize="10" LineHeight="1.3" />
                        <VerticalStackLayout x:Name="DisputeOpenForm" Spacing="8">
                            <Label Text="Reason" Style="{StaticResource FieldLabelStyle}" />
                            <Border Padding="10,2" Stroke="{AppThemeBinding Light=#CFE0D7, Dark=#3A5045}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}" StrokeShape="RoundRectangle 12">
                            <Picker x:Name="DisputeReasonPicker" Title="Choose a reason" SelectedIndex="0">
                                <Picker.Items>
                                    <x:String>SERVICE_NOT_DELIVERED</x:String>
                                    <x:String>QUALITY_ISSUE</x:String>
                                    <x:String>REQUIREMENTS_MISMATCH</x:String>
                                    <x:String>PAYMENT_ISSUE</x:String>
                                    <x:String>CONDUCT</x:String>
                                    <x:String>OTHER</x:String>
                                </Picker.Items>
                            </Picker>
                            </Border>
                            <Label Text="Details" Style="{StaticResource FieldLabelStyle}" />
                            <Border Padding="11,7" Stroke="{AppThemeBinding Light=#CFE0D7, Dark=#3A5045}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#151D19}" StrokeShape="RoundRectangle 12">
                                <Editor x:Name="DisputeDetailsEntry" Placeholder="Describe the issue with specific facts" MaxLength="2000" HeightRequest="72" BackgroundColor="Transparent" TextChanged="OnDisputeDetailsChanged" />
                            </Border>
                            <controls:BusyButton x:Name="OpenDisputeButton" Text="Open dispute" BusyText="Opening dispute" Clicked="OnOpenDisputeClicked" IsEnabled="False" FillColor="#0F6B4F" TextColor="White" HeightRequest="46" CornerRadius="13" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="DisputeResponseGroup" IsVisible="False" Spacing="8">
                            <Editor x:Name="DisputeResponseEntry" Placeholder="Provide the requested response" MaxLength="4000" HeightRequest="72" TextChanged="OnDisputeResponseChanged" />
                            <controls:BusyButton x:Name="SubmitDisputeResponseButton" Text="Submit response" BusyText="Submitting response" Clicked="OnSubmitDisputeResponseClicked" IsEnabled="False" FillColor="#0F6B4F" TextColor="White" HeightRequest="46" CornerRadius="13" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                        <Label Text="Evidence upload and secure evidence downloads are currently available on CampusGig Web. Mobile supports opening, viewing, deadlines, responses, and outcomes without weakening file security."
                               FontSize="9" LineHeight="1.3" TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ReviewActions" IsVisible="False" Padding="18" BackgroundColor="{AppThemeBinding Light=#F4F3EC, Dark=#1C2520}"
                        Stroke="{AppThemeBinding Light=#DCE6E0, Dark=#314239}" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="LEAVE A REVIEW" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                        <Label Text="How was your experience?" FontSize="17" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#17211D, Dark=#F2F6F3}" />
                        <Label Text="Your feedback helps other clients choose confidently." FontSize="10"
                               TextColor="{AppThemeBinding Light=#66716B, Dark=#AAB6AF}" />
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                            <Button x:Name="Rating1Button" Grid.Column="0" Text="&#x2605;" CommandParameter="1" Clicked="OnRatingClicked" HeightRequest="46" CornerRadius="13" FontSize="19" />
                            <Button x:Name="Rating2Button" Grid.Column="1" Text="&#x2605;" CommandParameter="2" Clicked="OnRatingClicked" HeightRequest="46" CornerRadius="13" FontSize="19" />
                            <Button x:Name="Rating3Button" Grid.Column="2" Text="&#x2605;" CommandParameter="3" Clicked="OnRatingClicked" HeightRequest="46" CornerRadius="13" FontSize="19" />
                            <Button x:Name="Rating4Button" Grid.Column="3" Text="&#x2605;" CommandParameter="4" Clicked="OnRatingClicked" HeightRequest="46" CornerRadius="13" FontSize="19" />
                            <Button x:Name="Rating5Button" AutomationId="Rating5Button" Grid.Column="4" Text="&#x2605;" CommandParameter="5" Clicked="OnRatingClicked" HeightRequest="46" CornerRadius="13" FontSize="19" />
                        </Grid>
                        <Label x:Name="RatingSummaryLabel" Text="Select a rating" FontSize="11" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#526159, Dark=#B7C5BD}" />
                        <Border Padding="12,5" Stroke="{AppThemeBinding Light=#CFE0D7, Dark=#3A5045}"
                                BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#151D19}" StrokeShape="RoundRectangle 14">
                            <Editor x:Name="ReviewEntry" AutomationId="ReviewComment" Placeholder="Share what went well (optional)" MaxLength="1000" HeightRequest="86"
                                    TextChanged="OnReviewTextChanged" BackgroundColor="Transparent" />
                        </Border>
                        <Label x:Name="ReviewCounterLabel" Text="0/1000" FontSize="9" HorizontalTextAlignment="End"
                               TextColor="{AppThemeBinding Light=#738078, Dark=#93A49B}" />
                        <controls:BusyButton x:Name="SubmitReviewButton" AutomationId="SubmitReviewButton" Text="Submit review" BusyText="Submitting review" Clicked="OnReviewClicked"
                                             IsEnabled="False" FillColor="#0F6B4F" TextColor="White" WidthRequest="170" HeightRequest="48"
                                             CornerRadius="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="9">
                    <Label Text="ORDER HISTORY" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="#0F6B4F" />
                    <VerticalStackLayout x:Name="HistoryList" Spacing="9" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
