<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="PageLight">#F3F5F3</Color>
    <Color x:Key="SurfaceLight">#FAFBFA</Color>
    <Color x:Key="ElevatedLight">#FFFFFF</Color>
    <Color x:Key="BorderLight">#DDE3DF</Color>
    <Color x:Key="Success">#1F7A55</Color>
    <Color x:Key="SuccessSoft">#E4F4EB</Color>
    <Color x:Key="Warning">#8A650D</Color>
    <Color x:Key="WarningSoft">#FFF4D5</Color>
    <Color x:Key="Danger">#A93630</Color>
    <Color x:Key="DangerSoft">#FCE9E7</Color>
    <Color x:Key="Info">#365F9D</Color>
    <Color x:Key="InfoSoft">#E8EFFF</Color>

    <Color x:Key="Primary">#0F6B4F</Color>
    <Color x:Key="PrimaryDark">#83D6B6</Color>
    <Color x:Key="PrimaryDarkText">#17211D</Color>
    <Color x:Key="Secondary">#D9F36A</Color>
    <Color x:Key="SecondaryDarkText">#F2F6F3</Color>
    <Color x:Key="Tertiary">#287E56</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#0F6B4F</Color>
    <Color x:Key="MidnightBlue">#17211D</Color>
    <Color x:Key="OffBlack">#111713</Color>

    <Color x:Key="Gray100">#EEF2EF</Color>
    <Color x:Key="Gray200">#DDE4DF</Color>
    <Color x:Key="Gray300">#B9C5BE</Color>
    <Color x:Key="Gray400">#8A938E</Color>
    <Color x:Key="Gray500">#66716B</Color>
    <Color x:Key="Gray600">#3B4A42</Color>
    <Color x:Key="Gray900">#17211D</Color>
    <Color x:Key="Gray950">#111713</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
