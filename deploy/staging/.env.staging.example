# Copy this file to deploy/staging/.env and replace every example value.
CAMPUSGIG_DOMAIN=staging.campusgig.example
PUBLIC_ORIGIN=https://staging.campusgig.example
ACME_EMAIL=admin@example.com

POSTGRES_DB=campusgig_staging
POSTGRES_USER=campusgig_staging
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# URL-encode special characters in the password below.
DATABASE_URL=postgresql://campusgig_staging:replace-with-a-long-random-database-password@postgres:5432/campusgig_staging?schema=public

JWT_SECRET=replace-with-at-least-64-random-characters
MFA_ENCRYPTION_KEY=replace-with-a-different-64-character-random-value
PAYOUT_DESTINATION_ENCRYPTION_KEY=replace-with-another-64-character-random-value
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_IDLE_DAYS=7
REFRESH_TOKEN_ABSOLUTE_DAYS=30
REFRESH_TOKEN_REPLAY_GRACE_SECONDS=15

# Configure either Resend or Gmail SMTP. Resend with a verified domain is preferred.
RESEND_API_KEY=re_example
EMAIL_FROM=CampusGig <accounts@staging.campusgig.example>
SMTP_USER=
SMTP_APP_PASSWORD=

GOOGLE_WEB_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=

# Keep staging in test mode. A production deployment may explicitly select
# live only after its HTTPS domain and PayMongo live webhook are configured.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_replace
PAYMONGO_WEBHOOK_SECRET=whsk_test_replace
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya
PLATFORM_FEE_BASIS_POINTS=500
PLATFORM_FEE_MIN_CENTAVOS=0
RUSH_24_HOURS_BASIS_POINTS=2000
RUSH_12_HOURS_BASIS_POINTS=3000
RUSH_6_HOURS_BASIS_POINTS=4000
RUSH_3_HOURS_BASIS_POINTS=5000

# Use a private managed S3-compatible bucket. Do not enable public bucket access.
S3_BUCKET=campusgig-staging-private
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=campusgig-staging
S3_ACCESS_KEY_ID=replace-with-staging-access-key
S3_SECRET_ACCESS_KEY=replace-with-staging-secret-key
S3_KMS_KEY_ID=
STORAGE_SIGNED_URL_TTL_SECONDS=300
CLAMAV_TIMEOUT_MS=30000
READINESS_TIMEOUT_MS=5000
