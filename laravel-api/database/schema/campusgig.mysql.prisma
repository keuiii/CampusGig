generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRole {
  CLIENT
  STUDENT
  PROVIDER
  ORG_MEMBER
  SCHOOL_ADMIN
  ADMIN
}

enum AccountCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SocialProvider {
  GOOGLE
  FACEBOOK
}

enum AuthClientType {
  WEB
  MOBILE
}

enum SchoolStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum VerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  REJECTED
  ARCHIVED
}

enum DeliveryMethod {
  ONLINE
  IN_PERSON
  HYBRID
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum ServicePricingModel {
  LEGACY_PACKAGES
  SINGLE_PRICE_V2
}

enum OrderPricingModel {
  LEGACY_PACKAGE_V1
  SINGLE_PRICE_V2
}

enum RushTier {
  HOURS_24
  HOURS_12
  HOURS_6
  HOURS_3
}

enum DeliveryOption {
  NORMAL
  RUSH_24_HOURS
  RUSH_12_HOURS
  RUSH_6_HOURS
  RUSH_3_HOURS
}

enum ServiceMediaKind {
  COVER
  PORTFOLIO
}

enum OrderStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum OrderCompletionSource {
  CLIENT_ACCEPTED
  AUTO_REVIEW_TIMEOUT
}

enum OrderFilePurpose {
  REQUIREMENT
  MESSAGE_ATTACHMENT
  DELIVERABLE
  REVISION
}

enum DeliveryFileAccessType {
  ACCESS_GRANTED
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum ConversationKind {
  ORDER
  INQUIRY
}

enum RevisionStatus {
  AWAITING_PROVIDER_ACKNOWLEDGEMENT
  OPEN
  DECLINED
  RESOLVED
  CANCELLED
}

enum RevisionType {
  PROVIDER_CORRECTION
  INCLUDED
  PAID_EXTRA
}

enum RevisionPurchaseActivationStatus {
  PENDING
  ACTIVATED
  RECONCILIATION_REQUIRED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  WAITING_FOR_CLIENT
  WAITING_FOR_PROVIDER
  READY_FOR_REVIEW
  UNDER_REVIEW
  RESOLVED_CLIENT
  RESOLVED_PROVIDER
  CLOSED
}

enum DisputeResponseParty {
  CLIENT
  PROVIDER
}

enum DisputeTimelineEventType {
  OPENED
  EVIDENCE_ADDED
  RESPONSE_REQUESTED
  RESPONSE_SUBMITTED
  RESPONSE_DEADLINE_EXPIRED
  READY_FOR_REVIEW
  REVIEW_STARTED
  RESOLVED_CLIENT
  RESOLVED_PROVIDER
  CLOSED
}

enum DisputeReason {
  SERVICE_NOT_DELIVERED
  QUALITY_ISSUE
  REQUIREMENTS_MISMATCH
  PAYMENT_ISSUE
  CONDUCT
  OTHER
}

enum PaymentProvider {
  PAYMONGO
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum ProviderEarningStatus {
  PENDING
  AVAILABLE
  FROZEN
  PAYOUT_PROCESSING
  PAID_OUT
  REFUNDED
}

enum ProviderEarningLedgerEntryType {
  EARNING_PENDING_CREDIT
  EARNING_AVAILABLE_RELEASE
  EARNING_FROZEN
  EARNING_UNFROZEN
  EARNING_REFUND_REVERSAL
  EARNING_PAYOUT_RESERVED
  EARNING_PAYOUT_RELEASED
  EARNING_PAID_OUT
}

enum ProviderEarningSource {
  ORIGINAL_ORDER
  PAID_EXTRA_REVISION
}

enum RefundStatus {
  REQUESTED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  RECONCILIATION_REQUIRED
}

enum MarketplaceRefundSource {
  ORIGINAL_ORDER
  PAID_EXTRA_REVISION
}

enum MarketplaceRefundReason {
  PAID_NOT_STARTED
  MISSED_RUSH_DEADLINE
  DISPUTE_CLIENT_WIN
  STALE_REVISION_PAYMENT
  ADMIN_EXCEPTION
}

enum RefundRequestOrigin {
  CLIENT
  ADMIN
  SYSTEM
}

enum PlatformFeeLedgerEntryType {
  REFUND_REVERSAL
}

enum PayoutDestinationType {
  BANK_ACCOUNT
  E_WALLET
}

enum PayoutDestinationVerificationStatus {
  UNVERIFIED
  ADMIN_REVIEWED
  PROVIDER_VERIFIED
}

enum ProviderPayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
  CANCELLED
  RECONCILIATION_REQUIRED
}

enum PayoutSettlementMethod {
  MANUAL
  EXTERNAL_PROVIDER
}

enum ProviderPayoutAuditAction {
  REQUESTED
  CANCELLED
  APPROVED
  REJECTED
  PROCESSING
  MANUAL_SETTLED
  EXTERNAL_RECONCILED
  FAILED
  RECONCILIATION_REQUIRED
}

enum SupportTicketCategory {
  ACCOUNT
  PAYMENT
  ORDER
  TECHNICAL
  SAFETY
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketSource {
  WEB
  MOBILE
}

model User {
  id                          String                       @id @default(uuid()) @db.Char(36)
  email                       String                       @unique
  passwordHash                String
  displayName                 String
  avatarPath                  String?
  status                      UserStatus                   @default(PENDING)
  lastSeenAt                  DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  emailVerifiedAt             DateTime?
  mfaEnabledAt                DateTime?
  mfaSecretCipher             String?
  mfaPendingSecretCipher      String?
  mfaLastUsedStep             BigInt?
  sessionVersion              Int                          @default(0)
  roles                       UserRoleAssignment[]
  studentProfile              StudentProfile?
  providerProfile             ProviderProfile?
  services                    Service[]                    @relation("ProviderServices")
  savedServices               SavedService[]
  clientOrders                Order[]                      @relation("ClientOrders")
  providerOrders              Order[]                      @relation("ProviderOrders")
  sentMessages                Message[]
  conversationLinks           ConversationParticipant[]
  inquiriesStarted            Conversation[]               @relation("InquiryClient")
  inquiriesReceived           Conversation[]               @relation("InquiryProvider")
  uploadedFiles               OrderFile[]
  deliverySubmissions         DeliverySubmission[]         @relation("DeliverySubmissionProvider")
  deliveryFileAccesses        DeliveryFileAccessAudit[]    @relation("DeliveryFileAccessUser")
  providerEarnings            ProviderEarning[]            @relation("ProviderEarningProvider")
  earningLedgerEntries        ProviderEarningLedgerEntry[] @relation("ProviderEarningLedgerProvider")
  reviewsWritten              Review[]                     @relation("ReviewsWritten")
  reviewsReceived             Review[]                     @relation("ReviewsReceived")
  statusChanges               OrderStatusHistory[]
  revisionRequests            RevisionRequest[]
  revisionPurchasesAsClient   OrderRevisionPurchase[]      @relation("RevisionPurchaseClient")
  revisionPurchasesAsProvider OrderRevisionPurchase[]      @relation("RevisionPurchaseProvider")
  accountCodes                AccountCode[]
  mfaRecoveryCodes            MfaRecoveryCode[]
  mfaChallenges               MfaChallenge[]
  trustedDevices              TrustedDevice[]
  authSessions                AuthSession[]
  passwordChangeRequests      PasswordChangeRequest[]
  socialAccounts              SocialAccount[]
  schoolAdminAssignment       SchoolAdminAssignment?
  notifications               Notification[]               @relation("NotificationRecipient")
  disputesOpened              OrderDispute[]               @relation("DisputesOpened")
  disputesResolved            OrderDispute[]               @relation("DisputesResolved")
  disputeResponses            DisputeResponse[]            @relation("DisputeResponseAuthor")
  disputeEvidence             DisputeEvidence[]            @relation("DisputeEvidenceSubmitter")
  disputeTimelineEvents       DisputeTimelineEvent[]       @relation("DisputeTimelineActor")
  supportTickets              SupportTicket[]
  refundsRequested            PaymentRefund[]              @relation("RefundRequestedBy")
  payoutDestinations          ProviderPayoutDestination[]  @relation("PayoutDestinationProvider")
  payoutDestinationsReviewed  ProviderPayoutDestination[]  @relation("PayoutDestinationReviewer")
  providerPayouts             ProviderPayout[]             @relation("ProviderPayoutProvider")
  payoutsApproved             ProviderPayout[]             @relation("ProviderPayoutApprover")
  payoutsSettled              ProviderPayout[]             @relation("ProviderPayoutSettler")
  payoutAudits                ProviderPayoutAudit[]        @relation("ProviderPayoutAuditActor")
}

model SupportTicket {
  id         String                @id @default(uuid()) @db.Char(36)
  userId     String                @db.Char(36)
  category   SupportTicketCategory
  subject    String
  message    String                @db.Text
  source     SupportTicketSource
  status     SupportTicketStatus   @default(OPEN)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  resolvedAt DateTime?
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuthSession {
  id             String         @id @default(uuid()) @db.Char(36)
  userId         String         @db.Char(36)
  clientType     AuthClientType
  deviceName     String
  sessionVersion Int
  expiresAt      DateTime
  lastUsedAt     DateTime       @default(now())
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]

  @@index([userId, revokedAt, lastUsedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Char(36)
  sessionId String      @db.Char(36)
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt, revokedAt])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model MfaChallenge {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  tokenHash  String    @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TrustedDevice {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordChangeRequest {
  id              String    @id @default(uuid()) @db.Char(36)
  userId          String    @db.Char(36)
  newPasswordHash String
  tokenHash       String    @unique
  status          String    @default("PENDING")
  expiresAt       DateTime
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model SocialAccount {
  id             String         @id @default(uuid()) @db.Char(36)
  userId         String         @db.Char(36)
  provider       SocialProvider
  providerUserId String
  providerEmail  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([providerEmail])
}

model AccountCode {
  id         String             @id @default(uuid()) @db.Char(36)
  userId     String             @db.Char(36)
  purpose    AccountCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int                @default(0)
  consumedAt DateTime?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model ProviderProfile {
  userId           String   @id @db.Char(36)
  headline         String
  bio              String   @db.Text
  skills           Json     @default("[]")
  isAvailable      Boolean  @default(true)
  maxActiveOrders  Int      @default(5)
  maxPendingOrders Int      @default(50)
  instagramUrl     String?
  linkedinUrl      String?
  xUrl             String?
  portfolioUrl     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRoleAssignment {
  userId    String   @db.Char(36)
  role      UserRole
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model School {
  id              String                  @id @default(uuid()) @db.Char(36)
  name            String
  shortName       String
  emailDomain     String?
  address         String?
  city            String                  @default("Lipa City")
  status          SchoolStatus            @default(PENDING)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  studentProfiles StudentProfile[]
  verifications   VerificationRequest[]
  administrators  SchoolAdminAssignment[]
}

model SchoolAdminAssignment {
  userId    String   @id @db.Char(36)
  schoolId  String   @db.Char(36)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model StudentProfile {
  userId              String             @id @db.Char(36)
  schoolId            String             @db.Char(36)
  studentNumberCipher String?
  program             String?
  yearLevel           Int?
  bio                 String?            @db.Text
  verificationStatus  VerificationStatus @default(UNSUBMITTED)
  verifiedAt          DateTime?
  ratingAverage       Decimal            @default(0) @db.Decimal(3, 2)
  reviewCount         Int                @default(0)
  completedOrderCount Int                @default(0)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  school              School             @relation(fields: [schoolId], references: [id])

  @@index([schoolId, verificationStatus])
}

model VerificationRequest {
  id                String             @id @default(uuid()) @db.Char(36)
  userId            String             @db.Char(36)
  schoolId          String             @db.Char(36)
  studentIdFilePath String
  status            VerificationStatus @default(PENDING)
  submittedAt       DateTime           @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?            @db.Char(36)
  rejectionReason   String?            @db.Text
  school            School             @relation(fields: [schoolId], references: [id])

  @@index([status, submittedAt])
}

model Category {
  id        String    @id
  name      String
  icon      String?
  color     String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id                    String              @id @default(uuid()) @db.Char(36)
  providerId            String              @db.Char(36)
  categoryId            String
  title                 String
  slug                  String              @unique
  description           String              @db.Text
  deliveryMethod        DeliveryMethod      @default(ONLINE)
  pricingModel          ServicePricingModel @default(LEGACY_PACKAGES)
  basePriceCentavos     Int?
  normalDeliveryMinutes Int?
  includedRevisionLimit Int?
  acceptsRushOrders     Boolean             @default(false)
  fastestRushTier       RushTier?
  campusLocation        String?
  status                ServiceStatus       @default(DRAFT)
  publishedAt           DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?             @db.Char(36)
  rejectionReason       String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  provider              User                @relation("ProviderServices", fields: [providerId], references: [id])
  category              Category            @relation(fields: [categoryId], references: [id])
  packages              ServicePackage[]
  media                 ServiceMedia[]
  orders                Order[]
  savedBy               SavedService[]

  @@index([status, categoryId, publishedAt])
  @@index([providerId, status])
}

model SavedService {
  userId    String   @db.Char(36)
  serviceId String   @db.Char(36)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  @@index([userId, createdAt])
}

model ServiceMedia {
  id           String           @id @default(uuid()) @db.Char(36)
  serviceId    String           @db.Char(36)
  kind         ServiceMediaKind
  storagePath  String           @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  service      Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, kind, sortOrder])
}

model ServicePackage {
  id            String      @id @default(uuid()) @db.Char(36)
  serviceId     String      @db.Char(36)
  tier          PackageTier
  name          String
  description   String      @db.Text
  priceCentavos Int
  deliveryDays  Int
  revisionLimit Int         @default(0)
  isActive      Boolean     @default(true)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([serviceId, tier])
}

model Order {
  id                         String                       @id @default(uuid()) @db.Char(36)
  orderNumber                String                       @unique
  clientRequestId            String?                      @db.Char(36)
  requestFingerprint         String?
  clientId                   String                       @db.Char(36)
  providerId                 String                       @db.Char(36)
  serviceId                  String                       @db.Char(36)
  servicePackageId           String?                      @db.Char(36)
  pricingModel               OrderPricingModel            @default(LEGACY_PACKAGE_V1)
  titleSnapshot              String
  packageSnapshot            Json?
  termsSnapshot              Json
  basePriceCentavos          Int?
  rushSurchargeCentavos      Int?
  deliveryOption             DeliveryOption?
  deliveryDurationMinutes    Int?
  pricingPolicyVersion       Int?
  platformFeeBasisPoints     Int?
  rushBasisPoints            Int?
  subtotalCentavos           Int
  platformFeeCentavos        Int                          @default(0)
  totalCentavos              Int
  currency                   String                       @default("PHP")
  requirements               String                       @db.Text
  dueAt                      DateTime?
  status                     OrderStatus                  @default(REQUESTED)
  revisionLimit              Int                          @default(0)
  revisionsUsed              Int                          @default(0)
  acceptedAt                 DateTime?
  startedAt                  DateTime?
  submittedAt                DateTime?
  completedAt                DateTime?
  completionSource           OrderCompletionSource?
  reviewPolicyVersion        Int?
  reviewStartedAt            DateTime?
  reviewDeadlineAt           DateTime?
  reviewDeliverySubmissionId String?                      @unique @db.Char(36)
  clientArchivedAt           DateTime?
  clientRemovedAt            DateTime?
  providerArchivedAt         DateTime?
  providerRemovedAt          DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  client                     User                         @relation("ClientOrders", fields: [clientId], references: [id])
  provider                   User                         @relation("ProviderOrders", fields: [providerId], references: [id])
  service                    Service                      @relation(fields: [serviceId], references: [id])
  servicePackage             ServicePackage?              @relation(fields: [servicePackageId], references: [id], onDelete: Restrict)
  history                    OrderStatusHistory[]
  files                      OrderFile[]
  deliverySubmissions        DeliverySubmission[]
  reviewDeliverySubmission   DeliverySubmission?          @relation("OrderReviewDeliverySubmission", fields: [reviewDeliverySubmissionId], references: [id], onDelete: Restrict)
  deliveryFileAccesses       DeliveryFileAccessAudit[]
  conversation               Conversation?
  revisions                  RevisionRequest[]
  review                     Review?
  notifications              Notification[]
  disputes                   OrderDispute[]
  payments                   Payment[]
  providerEarnings           ProviderEarning[]
  revisionPurchases          OrderRevisionPurchase[]
  earningLedgerEntries       ProviderEarningLedgerEntry[]
  refunds                    PaymentRefund[]
  platformFeeLedgerEntries   PlatformFeeLedgerEntry[]

  @@unique([clientId, clientRequestId])
  @@index([clientId, status, createdAt])
  @@index([providerId, status, createdAt])
  @@index([status, reviewDeadlineAt, id])
  @@index([clientId, clientRemovedAt, clientArchivedAt, createdAt, id], map: "Order_clientId_clientRemovedAt_clientArchivedAt_createdAt_id_id")
  @@index([providerId, providerRemovedAt, providerArchivedAt, createdAt, id], map: "Order_providerId_providerRemovedAt_providerArchivedAt_createdAt")
}

model OrderDispute {
  id                         String                   @id @default(uuid()) @db.Char(36)
  orderId                    String                   @db.Char(36)
  openedById                 String                   @db.Char(36)
  reason                     DisputeReason
  details                    String                   @db.Text
  status                     DisputeStatus            @default(OPEN)
  targetDeliverySubmissionId String?                  @db.Char(36)
  targetRevisionRequestId    String?                  @db.Char(36)
  targetRevisionPurchaseId   String?                  @db.Char(36)
  responseRequestedFrom      DisputeResponseParty?
  responseRequestedAt        DateTime?
  responseDeadlineAt         DateTime?
  responseRequestSequence    Int                      @default(0)
  reviewPausedAt             DateTime?
  reviewRemainingSeconds     Int?
  readyForReviewAt           DateTime?
  reviewStartedAt            DateTime?
  resolutionNote             String?                  @db.Text
  resolvedById               String?                  @db.Char(36)
  resolvedAt                 DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  order                      Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy                   User                     @relation("DisputesOpened", fields: [openedById], references: [id])
  resolvedBy                 User?                    @relation("DisputesResolved", fields: [resolvedById], references: [id])
  targetDeliverySubmission   DeliverySubmission?      @relation("DisputeTargetDelivery", fields: [targetDeliverySubmissionId], references: [id], onDelete: Restrict)
  targetRevisionRequest      RevisionRequest?         @relation("DisputeTargetRevision", fields: [targetRevisionRequestId], references: [id], onDelete: Restrict)
  targetRevisionPurchase     OrderRevisionPurchase?   @relation("DisputeTargetRevisionPurchase", fields: [targetRevisionPurchaseId], references: [id], onDelete: Restrict)
  affectedEarnings           DisputeAffectedEarning[]
  responses                  DisputeResponse[]
  evidence                   DisputeEvidence[]
  timeline                   DisputeTimelineEvent[]
  refunds                    PaymentRefund[]

  @@index([status, createdAt])
  @@index([orderId, createdAt])
  @@index([status, responseDeadlineAt, id])
  @@index([targetDeliverySubmissionId])
  @@index([targetRevisionRequestId])
  @@index([targetRevisionPurchaseId])
}

model DisputeAffectedEarning {
  id                String                @id @default(uuid()) @db.Char(36)
  disputeId         String                @db.Char(36)
  providerEarningId String                @db.Char(36)
  preFreezeStatus   ProviderEarningStatus
  frozenAt          DateTime              @default(now())
  restoredAt        DateTime?
  createdAt         DateTime              @default(now())
  dispute           OrderDispute          @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  providerEarning   ProviderEarning       @relation(fields: [providerEarningId], references: [id], onDelete: Restrict)

  @@unique([disputeId, providerEarningId])
  @@index([providerEarningId, createdAt])
}

model DisputeResponse {
  id                  String               @id @default(uuid()) @db.Char(36)
  disputeId           String               @db.Char(36)
  responderId         String               @db.Char(36)
  requestedFrom       DisputeResponseParty
  requestSequence     Int
  details             String               @db.Text
  responseRequestedAt DateTime
  responseDeadlineAt  DateTime
  createdAt           DateTime             @default(now())
  dispute             OrderDispute         @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  responder           User                 @relation("DisputeResponseAuthor", fields: [responderId], references: [id], onDelete: Restrict)
  evidence            DisputeEvidence[]

  @@unique([disputeId, requestSequence])
  @@index([responderId, createdAt])
}

model DisputeEvidence {
  id            String           @id @default(uuid()) @db.Char(36)
  disputeId     String           @db.Char(36)
  responseId    String?          @db.Char(36)
  submittedById String           @db.Char(36)
  storagePath   String           @unique
