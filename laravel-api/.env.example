APP_NAME=CampusGig
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:4000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campusgig
DB_USERNAME=campusgig
DB_PASSWORD=
MIGRATION_SOURCE_DATABASE_URL=
MIGRATION_SOURCE_DB_SSLMODE=prefer

WEB_ORIGIN=http://localhost:3000
JWT_SECRET=
MFA_ENCRYPTION_KEY=
PAYOUT_DESTINATION_ENCRYPTION_KEY=
METRICS_TOKEN=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_IDLE_DAYS=7
REFRESH_TOKEN_ABSOLUTE_DAYS=30
REFRESH_TOKEN_REPLAY_GRACE_SECONDS=15
# Local-only escape hatch when no mail transport is configured. Keep false in production.
EXPOSE_DEVELOPMENT_AUTH_CODES=true
EMAIL_ACTION_BASE_URL=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya
PAYMONGO_SUCCESS_URL=http://localhost:3000/orders/{ORDER_ID}/payment/return
PAYMONGO_CANCEL_URL=http://localhost:3000/orders/{ORDER_ID}
PAYMONGO_MOBILE_RETURN_ORIGIN=http://localhost:4000/api/v1/payments/mobile-return
PAYMONGO_MOBILE_SUCCESS_URL=
PAYMONGO_MOBILE_CANCEL_URL=
PLATFORM_FEE_PERCENT=5
PLATFORM_FEE_BASIS_POINTS=500
PLATFORM_FEE_MIN_CENTAVOS=0
RUSH_24_HOURS_BASIS_POINTS=2000
RUSH_12_HOURS_BASIS_POINTS=3000
RUSH_6_HOURS_BASIS_POINTS=4000
RUSH_3_HOURS_BASIS_POINTS=5000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_STORAGE_DISK=campusgig_private
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_ROOT=
MALWARE_SCANNER_DRIVER=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
PHPMUSSEL_RUNTIME_PATH=
PHPMUSSEL_SIGNATURE_MAX_AGE_DAYS=14
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
